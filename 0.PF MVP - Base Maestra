-- ============================================================
-- FUNCIONES HELPER Y NORMALIZADORES
-- ============================================================
CREATE TEMP FUNCTION ZEROS_TO_NULL(s STRING) AS (
  CASE
    WHEN s IS NULL THEN NULL
    WHEN TRIM(s) = "" THEN NULL
    WHEN REGEXP_CONTAINS(TRIM(s), r"^0+$") THEN NULL
    ELSE TRIM(s)
  END
);

CREATE TEMP FUNCTION NORM_KEY10(x STRING) AS (
  SUBSTR(UPPER(REGEXP_REPLACE(TRIM(IFNULL(x, "")), r'[^A-Z0-9]', "")), 1, 10)
);

CREATE TEMP FUNCTION NORM_CURP18(x STRING) AS (
  SUBSTR(UPPER(REGEXP_REPLACE(TRIM(IFNULL(x, "")), r'[^A-Z0-9]', "")), 1, 18)
);

CREATE TEMP FUNCTION IS_CURP18(x STRING) AS (
  REGEXP_CONTAINS(x, r'^[A-Z]{4}[0-9]{6}[A-Z0-9]{8}$')
);

CREATE TEMP FUNCTION IS_CURP10(x STRING) AS (
  REGEXP_CONTAINS(x, r'^[A-Z]{4}[0-9]{6}$')
);

CREATE TEMP FUNCTION NORM_EMAIL(s STRING) AS (
  NULLIF(TRIM(LOWER(s)), '')
);

CREATE TEMP FUNCTION NORM_PHONE(s STRING) AS (
  CASE
    WHEN ZEROS_TO_NULL(REGEXP_REPLACE(COALESCE(s, ''), r'\D', '')) IS NULL THEN NULL
    ELSE SUBSTR(ZEROS_TO_NULL(REGEXP_REPLACE(COALESCE(s, ''), r'\D', '')), -10)
  END
);

CREATE TEMP FUNCTION NORM_REF_PHONE(s STRING) AS (
  CASE
    WHEN ZEROS_TO_NULL(REGEXP_REPLACE(COALESCE(s, ''), r'\D', '')) IS NULL THEN NULL
    WHEN SUBSTR(ZEROS_TO_NULL(REGEXP_REPLACE(COALESCE(s, ''), r'\D', '')), -10) IN (
      '5555555555', '5500000000', '45', '9510000000', '5000000000',
      '3300000000', '6180000000', '4490000000', '3510000000', '8100000000',
      '550000000', '3110000000', '6120000000', '4430000000', '2299000000',
      '4770000000', '8440000000', '1111111111', '300000000'
    ) THEN NULL
    ELSE SUBSTR(ZEROS_TO_NULL(REGEXP_REPLACE(COALESCE(s, ''), r'\D', '')), -10)
  END
);

-- ============================================================
-- 1. UNIVERSO INICIAL Y VINCULACIÓN CLIENTE-CUENTAS
-- ============================================================
CREATE TEMP TABLE UNIV_INI AS (
  WITH UNIV_INI_AUX AS (
    SELECT
      B.TIP_INF AS TIP_INF,
      A.CTE_CVE_UNICO,
      A.CTE_CVE,
      A.CTA_CVE,
      A.TRJ_NUM,
      A.IND_TIT,
      A.NUM_CONSECUTIVO_TRJ AS TRJ_SEQ, 
      A.TRJ_EDO_CVE,
      A.BLQ_TRJ_CVE,
      A.RAZON_BLQ_TRJ_CVE,
      IF(A.FCH_ALTA_TRJ IN (DATE(9999,12,31), DATE(1900,01,01)), NULL, A.FCH_ALTA_TRJ) AS FCH_ALTA_TRJ, 
      IF(A.FCH_EMB_TRJ IN (DATE(9999,12,31), DATE(1900,01,01)), NULL, A.FCH_EMB_TRJ) AS FCH_EMB_TRJ,
      IF(A.FCH_BLQ_TRJ IN (DATE(9999,12,31), DATE(1900,01,01)), NULL, A.FCH_BLQ_TRJ) AS FCH_BLQ_TRJ
    FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CTA_TRJ` AS A
    LEFT JOIN `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CTA` AS B
      ON A.CTA_CVE = B.CTA_CVE
    WHERE TRUNC(TRJ_NUM / 10000000000) NOT IN (479438, 421017)
      AND SAFE_CAST(IND_TIT AS NUMERIC) = 0
      AND (
        (FCH_ALTA_TRJ BETWEEN FE_INI AND FE_FIN)
        OR (FCH_EMB_TRJ BETWEEN FE_INI AND FE_FIN)
        OR (FCH_BLQ_TRJ BETWEEN FE_INI AND FE_FIN)
      )
  ),
  EMBOZADAS AS (
    SELECT DISTINCT  
      SAFE_CAST(TRJ AS NUMERIC) AS TRJ, 
      SAFE_CAST(CTA_CVE AS NUMERIC) AS CTA_CVE,
      TIP_INF,
      USR AS USR_VPL_R05, 
      FCH_MOV AS FCH_MOV_R05,  
      HRA_MOV AS HRA_MOV_R05
    FROM `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_EMBOSSER_MD_R05`
    WHERE FCH_MOV <= FE_FIN
      AND UPPER(TRIM(COD_DESC)) IN ('* NEW RECORD ADDED *','USER 5','USER 8','TEMP EMBOSSING NBR','ISSUE FLAG','EMBOSSER NAME 1','EMBOSSED NAME 1')
    QUALIFY ROW_NUMBER() OVER(PARTITION BY SAFE_CAST(TRJ AS NUMERIC) ORDER BY FCH_MOV, HRA_MOV) = 1
  ),
  CREACIONES_TRJ AS (
    SELECT DISTINCT 
      IF(LENGTH(TRIM(CTE_CVE)) = 16, CTE_CVE, CONCAT(SAFE_CAST(CTE_CVE AS NUMERIC), LPAD(CONCAT(SAFE_CAST(FLG1 AS NUMERIC)), 2, '0'))) AS TRJ, 
      CTE_CVE AS CTE_CVE_R09,
      FLG1,
      USR AS USR_VPL_CREA,
      FCH AS FCH_MOV_R09,
      HRA AS HRA_MOV_R09
    FROM `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_R09`
    WHERE FCH <= FE_FIN 
      AND UPPER(TRIM(DES)) IN ('* NEW RECORD ADDED *')
      AND SAFE_CAST(FLG1 AS NUMERIC) IS NOT NULL
    QUALIFY ROW_NUMBER() OVER(PARTITION BY IF(LENGTH(TRIM(CTE_CVE)) = 16, CTE_CVE, CONCAT(SAFE_CAST(CTE_CVE AS NUMERIC), LPAD(CONCAT(SAFE_CAST(FLG1 AS NUMERIC)), 2, '0'))) ORDER BY FCH, HRA NULLS LAST) = 1
  ),
  PREVIO AS (
    SELECT 
      A.TIP_INF AS TIP_INF_R,
      A.CTE_CVE_UNICO,
      A.CTA_CVE,
      A.TRJ_NUM,
      A.TRJ_EDO_CVE,
      A.BLQ_TRJ_CVE,
      A.RAZON_BLQ_TRJ_CVE,
      C.FCH_MOV_R05,
      C.HRA_MOV_R05,
      B.FCH_MOV_R09,
      B.HRA_MOV_R09,
      A.FCH_EMB_TRJ,
      A.FCH_ALTA_TRJ,
      A.FCH_BLQ_TRJ,
      CASE 
        WHEN A.FCH_EMB_TRJ IS NOT NULL THEN FCH_EMB_TRJ
        WHEN A.FCH_EMB_TRJ IS NULL AND A.TIP_INF = 110 AND A.TRJ_SEQ = 1 THEN FCH_ALTA_TRJ
        WHEN A.FCH_EMB_TRJ IS NULL AND A.TIP_INF = 110 AND A.TRJ_SEQ <> 1 THEN FCH_BLQ_TRJ
        WHEN A.FCH_EMB_TRJ IS NULL AND A.TIP_INF <> 110 AND A.CTA_CVE = A.TRJ_NUM THEN FCH_ALTA_TRJ
        WHEN A.FCH_EMB_TRJ IS NULL AND A.TIP_INF <> 110 AND A.CTA_CVE <> A.TRJ_NUM THEN FCH_BLQ_TRJ
      END AS FCH_TRJ_MOD,
      C.USR_VPL_R05,
      B.USR_VPL_CREA
    FROM UNIV_INI_AUX AS A
    LEFT JOIN CREACIONES_TRJ AS B ON A.TRJ_NUM = SAFE_CAST(B.TRJ AS NUMERIC)
    LEFT JOIN EMBOZADAS AS C ON A.TRJ_NUM = SAFE_CAST(C.TRJ AS NUMERIC)
  ),
  BASE AS (
    SELECT 
      *,
      COALESCE(FCH_MOV_R05, FCH_MOV_R09, FCH_EMB_TRJ, FCH_TRJ_MOD) AS FCH_REP,
      COALESCE(HRA_MOV_R05, HRA_MOV_R09, NULL) AS HRA_REP,
      CASE WHEN FCH_MOV_R05 IS NOT NULL OR FCH_EMB_TRJ IS NOT NULL THEN 1 ELSE 0 END AS FLG_EMBO
    FROM PREVIO
    WHERE COALESCE(HRA_MOV_R05, HRA_MOV_R09, NULL) IS NOT NULL
  ),
  TOTAL AS (
  SELECT 
    TRJ_NUM,
    CTE_CVE_UNICO,
    CTA_CVE,
    USR_VPL_R05,
    USR_VPL_CREA,
    FCH_REP AS FCH_GENERACION,
    HRA_REP AS HRA_GENERACION,
    TRJ_EDO_CVE,
    BLQ_TRJ_CVE,
    RAZON_BLQ_TRJ_CVE,
    FLG_EMBO
  FROM BASE
  WHERE FCH_REP >= FE_INI
  QUALIFY ROW_NUMBER() OVER(PARTITION BY CTA_CVE, FCH_REP ORDER BY FCH_REP, FLG_EMBO DESC, HRA_REP DESC) = 1
  )
  SELECT * FROM TOTAL 
  WHERE TRUE 
    AND FLG_EMBO = 1
    AND FCH_GENERACION BETWEEN FE_INI AND FE_FIN
);


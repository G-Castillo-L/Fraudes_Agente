-- 3. MOTOR BIOMÉTRICO
-- ============================================================
CREATE TEMP TABLE BIO_KEYS AS (
  WITH CTA_SRC AS (
    SELECT DISTINCT
      C.CTA_CVE,
      C.NOMBRE,
      C.CTE_CVE_RFC,
      S.APIA_CURP,
      S.APIA_RFC,
      S.FICO_RFC
    FROM CLIE_FTES_ALL AS C
    LEFT JOIN SOLICITUDES_ALL AS S ON C.CTA_CVE = S.CTA_CVE
  ),
  PRE AS (
    SELECT
      CTA_CVE,
      NORM_CURP18(CTE_CVE_RFC) AS K_CURP18_VPL,
      NORM_KEY10(CTE_CVE_RFC) AS K_KEY10_VPL,
      NORM_CURP18(APIA_CURP) AS K_CURP18_APIA,
      NORM_KEY10(APIA_RFC) AS K_KEY10_APIA,
      NORM_KEY10(FICO_RFC) AS K_KEY10_FICO,
      UPPER(TRANSLATE(TRIM(IFNULL(NOMBRE, "")), UNICO, ASCI)) AS K_NOM_N,
      CASE
        WHEN IS_CURP18(NORM_CURP18(CTE_CVE_RFC)) THEN SUBSTR(NORM_CURP18(CTE_CVE_RFC), 5, 6)
        WHEN IS_CURP18(NORM_CURP18(APIA_CURP)) THEN SUBSTR(NORM_CURP18(APIA_CURP), 5, 6)
        WHEN IS_CURP10(NORM_KEY10(CTE_CVE_RFC)) THEN SUBSTR(NORM_KEY10(CTE_CVE_RFC), 5, 6)
        ELSE NULL
      END AS DOB6
    FROM CTA_SRC
  )
  SELECT CTA_CVE, 'CURP' AS TYPE, 'VPL_CURP18' AS SRC, K_CURP18_VPL AS KEY_VAL, DOB6 FROM PRE WHERE K_CURP18_VPL IS NOT NULL AND IS_CURP18(K_CURP18_VPL)
  UNION DISTINCT
  SELECT CTA_CVE, 'CURP' AS TYPE, 'APIA_CURP18' AS SRC, K_CURP18_APIA AS KEY_VAL, DOB6 FROM PRE WHERE K_CURP18_APIA IS NOT NULL AND IS_CURP18(K_CURP18_APIA)
  UNION DISTINCT
  SELECT CTA_CVE, 'KEY10' AS TYPE, 'VPL_RFC10' AS SRC, K_KEY10_VPL AS KEY_VAL, DOB6 FROM PRE WHERE K_KEY10_VPL IS NOT NULL
  UNION DISTINCT
  SELECT CTA_CVE, 'KEY10' AS TYPE, 'APIA_RFC10' AS SRC, K_KEY10_APIA AS KEY_VAL, DOB6 FROM PRE WHERE K_KEY10_APIA IS NOT NULL
  UNION DISTINCT
  SELECT CTA_CVE, 'KEY10' AS TYPE, 'FICO_RFC10' AS SRC, K_KEY10_FICO AS KEY_VAL, DOB6 FROM PRE WHERE K_KEY10_FICO IS NOT NULL
  UNION DISTINCT
  SELECT CTA_CVE, 'NAME_DOB' AS TYPE, 'VPL_NAME_DOB' AS SRC, K_NOM_N AS KEY_VAL, DOB6 FROM PRE WHERE K_NOM_N IS NOT NULL AND DOB6 IS NOT NULL
);

CREATE TEMP TABLE BIO_ERN_KEYS AS (
  WITH KEY_CURP AS (SELECT DISTINCT KEY_VAL AS CURP18 FROM BIO_KEYS WHERE TYPE = 'CURP'),
  KEY_KEY10 AS (SELECT DISTINCT KEY_VAL AS KEY10 FROM BIO_KEYS WHERE TYPE = 'KEY10'),
  KEY_NAME_DOB AS (SELECT DISTINCT KEY_VAL AS NOM_N, DOB6 FROM BIO_KEYS WHERE TYPE = 'NAME_DOB'),
  PRE AS (
    SELECT DISTINCT
      DATETIME(E.FCH_ENR, E.HRA_ENR) AS TS_ENR,
      NORM_KEY10(E.CTE_CVE) AS KEY10,
      NORM_CURP18(E.CTE_CVE) AS CURP18,
      UPPER(TRANSLATE(TRIM(CONCAT(TRIM(IFNULL(E.CTE_NOM, "")), " ", TRIM(IFNULL(E.CTE_APE_PAT, "")), " ", TRIM(IFNULL(E.CTE_APE_MAT, "")))), UNICO, ASCI)) AS NOM_N,
      IF(IS_CURP18(NORM_CURP18(E.CTE_CVE)), SUBSTR(NORM_CURP18(E.CTE_CVE), 5, 6), NULL) AS DOB6,
      IF(TRIM(E.ENR_FLG) = "", NULL, TRIM(E.ENR_FLG)) AS ENR_FLG,
      IF(TRIM(E.CURP_FLG) = "", NULL, TRIM(E.CURP_FLG)) AS CURP_FLG,
      IF(TRIM(E.INE_FLG) = "", NULL, TRIM(E.INE_FLG)) AS INE_FLG,
      E.IUB
    FROM `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_ENR_BIO_CTE` AS E
    WHERE E.FCH_ENR BETWEEN FE_INI AND FE_FIN
  ),
  FIL AS (
    SELECT
      TS_ENR, KEY10, CURP18, NOM_N, DOB6, ENR_FLG, CURP_FLG, INE_FLG, IUB,
      CASE 
        WHEN ((UPPER(INE_FLG) LIKE '%VERIFICACION EXITOSA%' OR UPPER(INE_FLG) LIKE '%PENDIENTE%' OR UPPER(INE_FLG) LIKE '%INESPERADO%') AND ENR_FLG LIKE '%SRV000%') THEN 'EXITOSO'
        WHEN (UPPER(INE_FLG) LIKE '%VERIFICACION EXITOSA%' AND ENR_FLG NOT LIKE '%SRV000%') THEN 'FALLIDO - SIN RIESGO'
        WHEN UPPER(INE_FLG) LIKE '%HUELLA NO HIT%' THEN 'FALLIDO'
        WHEN UPPER(INE_FLG) LIKE 'NO COINCIDEN DATOS DE LA CREDENCIAL - [La identificacion no esta vigente]' THEN 'FALLIDO - SIN RIESGO'
        WHEN UPPER(INE_FLG) LIKE '%MINUCIA%' THEN 'FALLIDO - MINUCIAS'
        WHEN UPPER(INE_FLG) LIKE '%[La identificacion no esta vigente] [Nombre no coincide][Apellido Paterno no coincide][Apellido Materno no coincide]%' THEN 'FALLIDO'
        WHEN UPPER(INE_FLG) NOT LIKE '%HUELLA NO HIT%' AND INE_FLG IS NOT NULL THEN 'FALLIDO - RIESGO'
        WHEN (UPPER(CURP_FLG) LIKE '%EXITOSO%' AND ENR_FLG LIKE '%SRV000%' AND INE_FLG IS NULL) THEN 'EXITOSO'
        ELSE 'REV'
      END AS FLG_EXI_TIP,
      CASE 
        WHEN ((UPPER(INE_FLG) LIKE '%VERIFICACION EXITOSA%' OR UPPER(INE_FLG) LIKE'%PENDIENTE%' OR UPPER(INE_FLG) LIKE "%INESPERADO%") AND ENR_FLG LIKE '%SRV000%') THEN 'EXITOSO'
        WHEN (UPPER(INE_FLG) LIKE '%VERIFICACION EXITOSA%' AND ENR_FLG NOT LIKE '%SRV000%') THEN 'EXITOSO'
        WHEN UPPER(INE_FLG) LIKE '%HUELLA NO HIT%' THEN 'FALLIDO'
        WHEN UPPER(INE_FLG) LIKE 'NO COINCIDEN DATOS DE LA CREDENCIAL - [La identificacion no esta vigente]' THEN 'EXITOSO' 
        WHEN UPPER(INE_FLG) LIKE '%MINUCIA%' THEN 'FALLIDO'
        WHEN UPPER(INE_FLG) LIKE '%[La identificacion no esta vigente] [Nombre no coincide][Apellido Paterno no coincide][Apellido Materno no coincide]%' THEN 'FALLIDO'
        WHEN UPPER(INE_FLG) NOT LIKE '%HUELLA NO HIT%' AND INE_FLG IS NOT NULL THEN 'EXITOSO'
        WHEN (UPPER(CURP_FLG) LIKE '%EXITOSO%' AND ENR_FLG LIKE '%SRV000%' AND INE_FLG IS NULL) THEN 'EXITOSO'
        ELSE 'REV' 
      END AS FLG_EXI
    FROM PRE
    WHERE CURP18 IN (SELECT CURP18 FROM KEY_CURP)
       OR KEY10 IN (SELECT KEY10 FROM KEY_KEY10)
       OR STRUCT(NOM_N, DOB6) IN (SELECT AS STRUCT NOM_N, DOB6 FROM KEY_NAME_DOB)
  )
  SELECT TS_ENR, FLG_EXI, FLG_EXI_TIP, ENR_FLG, CURP_FLG, INE_FLG, IUB, CURP18 AS ENR_CURP18, 'CURP' AS TYPE, CURP18 AS KEY_VAL, '' AS KEY_DOB6 FROM FIL WHERE CURP18 IS NOT NULL
  UNION ALL
  SELECT TS_ENR, FLG_EXI, FLG_EXI_TIP, ENR_FLG, CURP_FLG, INE_FLG, IUB, CURP18 AS ENR_CURP18, 'KEY10' AS TYPE, KEY10 AS KEY_VAL, '' AS KEY_DOB6 FROM FIL WHERE KEY10 IS NOT NULL
  UNION ALL
  SELECT TS_ENR, FLG_EXI, FLG_EXI_TIP, ENR_FLG, CURP_FLG, INE_FLG, IUB, CURP18 AS ENR_CURP18, 'NAME_DOB' AS TYPE, NOM_N AS KEY_VAL, DOB6 AS KEY_DOB6 FROM FIL WHERE NOM_N IS NOT NULL AND DOB6 IS NOT NULL
);

CREATE TEMP TABLE BIO_AUT_KEYS AS (
  WITH KEY_CURP AS (SELECT DISTINCT KEY_VAL AS CURP18 FROM BIO_KEYS WHERE TYPE = 'CURP'),
  KEY_KEY10 AS (SELECT DISTINCT KEY_VAL AS KEY10 FROM BIO_KEYS WHERE TYPE = 'KEY10'),
  KEY_NAME_DOB AS (SELECT DISTINCT KEY_VAL AS NOM_N, DOB6 FROM BIO_KEYS WHERE TYPE = 'NAME_DOB'),
  PRE AS (
    SELECT DISTINCT
      DATETIME(A.FCH_AUT, A.HRA_AUT) AS TS_AUT,
      NORM_KEY10(A.CTE_CVE) AS KEY10,
      NORM_CURP18(A.CTE_CVE) AS CURP18,
      UPPER(TRANSLATE(TRIM(CONCAT(TRIM(IFNULL(A.CTE_NOM, "")), " ", TRIM(IFNULL(A.CTE_APE_PAT, "")), " ", TRIM(IFNULL(A.CTE_APE_MAT, "")))), UNICO, ASCI)) AS NOM_N,
      IF(IS_CURP18(NORM_CURP18(A.CTE_CVE)), SUBSTR(NORM_CURP18(A.CTE_CVE), 5, 6), NULL) AS DOB6,
      A.RESP_AUT
    FROM `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_AUT_BIO_CTE` AS A
    WHERE A.FCH_AUT BETWEEN FE_INI AND FE_FIN
  ),
  FIL AS (
    SELECT TS_AUT, KEY10, CURP18, NOM_N, DOB6, RESP_AUT FROM PRE
    WHERE CURP18 IN (SELECT CURP18 FROM KEY_CURP)
       OR KEY10 IN (SELECT KEY10 FROM KEY_KEY10)
       OR STRUCT(NOM_N, DOB6) IN (SELECT AS STRUCT NOM_N, DOB6 FROM KEY_NAME_DOB)
  )
  SELECT TS_AUT, RESP_AUT, 'CURP' AS TYPE, CURP18 AS KEY_VAL, '' AS KEY_DOB6 FROM FIL WHERE CURP18 IS NOT NULL
  UNION ALL
  SELECT TS_AUT, RESP_AUT, 'KEY10' AS TYPE, KEY10 AS KEY_VAL, '' AS KEY_DOB6 FROM FIL WHERE KEY10 IS NOT NULL
  UNION ALL
  SELECT TS_AUT, RESP_AUT, 'NAME_DOB' AS TYPE, NOM_N AS KEY_VAL, DOB6 AS KEY_DOB6 FROM FIL WHERE NOM_N IS NOT NULL AND DOB6 IS NOT NULL
);

CREATE TEMP TABLE BIO_ERN_KEYS_HIST AS (
  WITH KEY_CURP AS (SELECT DISTINCT KEY_VAL AS CURP18 FROM BIO_KEYS WHERE TYPE = 'CURP'),
  KEY_KEY10 AS (SELECT DISTINCT KEY_VAL AS KEY10 FROM BIO_KEYS WHERE TYPE = 'KEY10'),
  KEY_NAME_DOB AS (SELECT DISTINCT KEY_VAL AS NOM_N, DOB6 FROM BIO_KEYS WHERE TYPE = 'NAME_DOB'),
  PRE AS (
    SELECT DISTINCT
      DATETIME(E.FCH_ENR, E.HRA_ENR) AS TS_ENR,
      NORM_KEY10(E.CTE_CVE) AS KEY10,
      NORM_CURP18(E.CTE_CVE) AS CURP18,
      UPPER(TRANSLATE(TRIM(CONCAT(TRIM(IFNULL(E.CTE_NOM, "")), " ", TRIM(IFNULL(E.CTE_APE_PAT, "")), " ", TRIM(IFNULL(E.CTE_APE_MAT, "")))), UNICO, ASCI)) AS NOM_N,
      IF(IS_CURP18(NORM_CURP18(E.CTE_CVE)), SUBSTR(NORM_CURP18(E.CTE_CVE), 5, 6), NULL) AS DOB6
    FROM `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_ENR_BIO_CTE` AS E
  ),
  FIL AS (
    SELECT TS_ENR, KEY10, CURP18, NOM_N, DOB6 FROM PRE
    WHERE CURP18 IN (SELECT CURP18 FROM KEY_CURP)
       OR KEY10 IN (SELECT KEY10 FROM KEY_KEY10)
       OR STRUCT(NOM_N, DOB6) IN (SELECT AS STRUCT NOM_N, DOB6 FROM KEY_NAME_DOB)
  )
  SELECT TS_ENR, CURP18 AS ENR_CURP18, 'CURP' AS TYPE, CURP18 AS KEY_VAL, '' AS KEY_DOB6 FROM FIL WHERE CURP18 IS NOT NULL
  UNION ALL
  SELECT TS_ENR, CURP18 AS ENR_CURP18, 'KEY10' AS TYPE, KEY10 AS KEY_VAL, '' AS KEY_DOB6 FROM FIL WHERE KEY10 IS NOT NULL
  UNION ALL
  SELECT TS_ENR, CURP18 AS ENR_CURP18, 'NAME_DOB' AS TYPE, NOM_N AS KEY_VAL, DOB6 AS KEY_DOB6 FROM FIL WHERE NOM_N IS NOT NULL AND DOB6 IS NOT NULL
);

-- ============================================================
-- 4. DETERMINACIÓN DE ESTATUS Y FILTRADO TEMPRANO
-- ============================================================
CREATE TEMP TABLE BIO_TRJ_EVAL AS (
  WITH KEY_STATS AS (
    SELECT CTA_CVE, COUNT(1) AS CNT_KEYS FROM BIO_KEYS GROUP BY CTA_CVE
  ),
  BIO_OP AS (
    SELECT
      CONCAT(CAST(U.CTA_CVE AS STRING), '|', CAST(U.TRJ_NUM AS STRING)) AS ID_ROW,
      U.CTA_CVE,
      U.TRJ_NUM,
      S_CTA.BLOQ2,
      IFNULL(S.CNT_KEYS, 0) AS CNT_KEYS,
      U.FCH_GENERACION AS REF_FECHA,
      U.HRA_GENERACION AS REF_HORA,
      'EXACTO_UNIV' AS REF_MODO,
      IF(EXTRACT(HOUR FROM U.HRA_GENERACION) BETWEEN HR_OPEN AND HR_CLOSE, 1, 0) AS HAS_REF_IN_WINDOW,
      DATETIME(U.FCH_GENERACION, U.HRA_GENERACION) AS TS_REF,
      GREATEST(
        DATETIME(U.FCH_GENERACION, TIME(HR_OPEN, 0, 0)),
        DATETIME_SUB(DATETIME(U.FCH_GENERACION, U.HRA_GENERACION), INTERVAL MAX_SAME_DAY_MIN MINUTE)
      ) AS TS_LOW,
      LEAST(
        DATETIME(U.FCH_GENERACION, TIME(HR_CLOSE, 59, 59)),
        DATETIME_ADD(DATETIME(U.FCH_GENERACION, U.HRA_GENERACION), INTERVAL MAX_SAME_DAY_MIN MINUTE)
      ) AS TS_HIGH
    FROM UNIV_INI AS U
    LEFT JOIN KEY_STATS AS S ON U.CTA_CVE = S.CTA_CVE
    LEFT JOIN (SELECT CTA_CVE, BLOQ2 FROM SDO_CTA_ALL QUALIFY ROW_NUMBER() OVER(PARTITION BY CTA_CVE ORDER BY BR_SOLIC_CVE DESC) = 1) AS S_CTA ON U.CTA_CVE = S_CTA.CTA_CVE
  ),
  ROW_KEYS AS (
    SELECT
      O.ID_ROW, O.CTA_CVE, O.TRJ_NUM, O.BLOQ2, O.CNT_KEYS,
      O.REF_FECHA, O.REF_HORA, O.REF_MODO,
      O.TS_REF, O.TS_LOW, O.TS_HIGH, O.HAS_REF_IN_WINDOW,
      K.TYPE, K.SRC, K.KEY_VAL, K.DOB6
    FROM BIO_OP AS O
    LEFT JOIN BIO_KEYS AS K ON O.CTA_CVE = K.CTA_CVE
  ),
  ENR_MET AS (
    SELECT
      B.ID_ROW, B.TYPE, B.SRC, B.KEY_VAL, B.DOB6,
      ARRAY_AGG(
        IF(E.TS_ENR BETWEEN B.TS_LOW AND B.TS_REF AND DATE(E.TS_ENR) = B.REF_FECHA,
          STRUCT(E.TS_ENR AS TS_ENR, E.FLG_EXI AS FLG_EXI, E.FLG_EXI_TIP AS FLG_EXI_TIP, E.INE_FLG AS INE_FLG, E.CURP_FLG AS CURP_FLG, E.ENR_FLG AS ENR_FLG, DATETIME_DIFF(B.TS_REF, E.TS_ENR, MINUTE) AS DIFF_MIN),
          NULL)
        IGNORE NULLS ORDER BY E.TS_ENR DESC LIMIT 1
      )[SAFE_OFFSET(0)] AS ENR_BEFORE,
      ARRAY_AGG(
        IF(E.TS_ENR BETWEEN B.TS_LOW AND B.TS_REF AND DATE(E.TS_ENR) = B.REF_FECHA AND E.FLG_EXI = 'EXITOSO',
          STRUCT(E.TS_ENR AS TS_ENR, E.FLG_EXI AS FLG_EXI, E.FLG_EXI_TIP AS FLG_EXI_TIP, E.INE_FLG AS INE_FLG, E.CURP_FLG AS CURP_FLG, E.ENR_FLG AS ENR_FLG, DATETIME_DIFF(B.TS_REF, E.TS_ENR, MINUTE) AS DIFF_MIN),
          NULL)
        IGNORE NULLS ORDER BY E.TS_ENR DESC LIMIT 1
      )[SAFE_OFFSET(0)] AS ENR_BEFORE_OK,
      ARRAY_AGG(
        IF(B.HAS_REF_IN_WINDOW = 1 AND E.TS_ENR > B.TS_REF AND E.TS_ENR <= B.TS_HIGH AND DATE(E.TS_ENR) = B.REF_FECHA,
          STRUCT(E.TS_ENR AS TS_ENR, E.FLG_EXI AS FLG_EXI, E.FLG_EXI_TIP AS FLG_EXI_TIP, E.INE_FLG AS INE_FLG, E.CURP_FLG AS CURP_FLG, E.ENR_FLG AS ENR_FLG, DATETIME_DIFF(E.TS_ENR, B.TS_REF, MINUTE) AS DIFF_MIN),
          NULL)
        IGNORE NULLS ORDER BY E.TS_ENR ASC LIMIT 1
      )[SAFE_OFFSET(0)] AS ENR_AFTER,
      ARRAY_AGG(
        IF(B.HAS_REF_IN_WINDOW = 1 AND E.TS_ENR > B.TS_REF AND E.TS_ENR <= B.TS_HIGH AND DATE(E.TS_ENR) = B.REF_FECHA AND E.FLG_EXI = 'EXITOSO',
          STRUCT(E.TS_ENR AS TS_ENR, E.FLG_EXI AS FLG_EXI, E.FLG_EXI_TIP AS FLG_EXI_TIP, E.INE_FLG AS INE_FLG, E.CURP_FLG AS CURP_FLG, E.ENR_FLG AS ENR_FLG, DATETIME_DIFF(E.TS_ENR, B.TS_REF, MINUTE) AS DIFF_MIN),
          NULL)
        IGNORE NULLS ORDER BY E.TS_ENR ASC LIMIT 1
      )[SAFE_OFFSET(0)] AS ENR_AFTER_OK,
      STRING_AGG(
        IF(E.TS_ENR BETWEEN B.TS_LOW AND B.TS_REF AND DATE(E.TS_ENR) = B.REF_FECHA, FORMAT('%s %s [%s]', FORMAT_DATETIME('%H:%M', E.TS_ENR), E.FLG_EXI, E.FLG_EXI_TIP), NULL),
        ' > ' ORDER BY E.TS_ENR ASC LIMIT 5
      ) AS ENR_BEFORE_PATH,
      STRING_AGG(
        IF(B.HAS_REF_IN_WINDOW = 1 AND E.TS_ENR > B.TS_REF AND E.TS_ENR <= B.TS_HIGH AND DATE(E.TS_ENR) = B.REF_FECHA, FORMAT('%s %s [%s]', FORMAT_DATETIME('%H:%M', E.TS_ENR), E.FLG_EXI, E.FLG_EXI_TIP), NULL),
        ' > ' ORDER BY E.TS_ENR ASC LIMIT 5
      ) AS ENR_AFTER_PATH,
      COUNTIF(E.TS_ENR BETWEEN B.TS_LOW AND B.TS_REF AND DATE(E.TS_ENR) = B.REF_FECHA) AS ENR_BEFORE_CNT,
      COUNTIF(E.TS_ENR BETWEEN B.TS_LOW AND B.TS_REF AND DATE(E.TS_ENR) = B.REF_FECHA AND E.FLG_EXI = 'EXITOSO') AS ENR_BEFORE_OK_CNT,
      COUNTIF(B.HAS_REF_IN_WINDOW = 1 AND E.TS_ENR > B.TS_REF AND E.TS_ENR <= B.TS_HIGH AND DATE(E.TS_ENR) = B.REF_FECHA) AS ENR_AFTER_CNT,
      COUNTIF(B.HAS_REF_IN_WINDOW = 1 AND E.TS_ENR > B.TS_REF AND E.TS_ENR <= B.TS_HIGH AND DATE(E.TS_ENR) = B.REF_FECHA AND E.FLG_EXI = 'EXITOSO') AS ENR_AFTER_OK_CNT
    FROM ROW_KEYS AS B
    LEFT JOIN BIO_ERN_KEYS AS E
      ON B.TYPE = E.TYPE AND B.KEY_VAL = E.KEY_VAL AND IF(B.TYPE = 'NAME_DOB', B.DOB6, '') = E.KEY_DOB6
    GROUP BY B.ID_ROW, B.TYPE, B.SRC, B.KEY_VAL, B.DOB6
  ),
  ENR_HIST_MET AS (
    SELECT
      B.ID_ROW, B.TYPE, B.SRC, B.KEY_VAL, B.DOB6,
      LOGICAL_OR(E.TS_ENR <= B.TS_REF) AS HAS_ENR_HIST_ANY,
      ARRAY_AGG(
        IF(E.TS_ENR <= B.TS_REF, STRUCT(E.TS_ENR AS TS_ENR, DATETIME_DIFF(B.TS_REF, E.TS_ENR, MINUTE) AS DIFF_MIN, DATETIME_DIFF(B.TS_REF, E.TS_ENR, DAY) AS DIFF_DAY), NULL)
        IGNORE NULLS ORDER BY E.TS_ENR DESC LIMIT 1
      )[SAFE_OFFSET(0)] AS ENR_HIST_LAST_ANY
    FROM ROW_KEYS AS B
    LEFT JOIN BIO_ERN_KEYS_HIST AS E
      ON B.TYPE = E.TYPE AND B.KEY_VAL = E.KEY_VAL AND IF(B.TYPE = 'NAME_DOB', B.DOB6, '') = E.KEY_DOB6
    GROUP BY B.ID_ROW, B.TYPE, B.SRC, B.KEY_VAL, B.DOB6
  ),
  AUT_MET AS (
    SELECT
      B.ID_ROW, B.TYPE, B.SRC, B.KEY_VAL, B.DOB6,
      ARRAY_AGG(
        IF(A.TS_AUT BETWEEN B.TS_LOW AND B.TS_REF AND DATE(A.TS_AUT) = B.REF_FECHA, STRUCT(A.TS_AUT AS TS_AUT, A.RESP_AUT AS RESP_AUT, DATETIME_DIFF(B.TS_REF, A.TS_AUT, MINUTE) AS DIFF_MIN), NULL)
        IGNORE NULLS ORDER BY A.TS_AUT DESC LIMIT 1
      )[SAFE_OFFSET(0)] AS AUT_BEFORE,
      ARRAY_AGG(
        IF(A.TS_AUT BETWEEN B.TS_LOW AND B.TS_REF AND DATE(A.TS_AUT) = B.REF_FECHA AND A.RESP_AUT = 'AUTENTICACION EXITOSA', STRUCT(A.TS_AUT AS TS_AUT, A.RESP_AUT AS RESP_AUT, DATETIME_DIFF(B.TS_REF, A.TS_AUT, MINUTE) AS DIFF_MIN), NULL)
        IGNORE NULLS ORDER BY A.TS_AUT DESC LIMIT 1
      )[SAFE_OFFSET(0)] AS AUT_BEFORE_OK,
      ARRAY_AGG(
        IF(B.HAS_REF_IN_WINDOW = 1 AND A.TS_AUT > B.TS_REF AND A.TS_AUT <= B.TS_HIGH AND DATE(A.TS_AUT) = B.REF_FECHA, STRUCT(A.TS_AUT AS TS_AUT, A.RESP_AUT AS RESP_AUT, DATETIME_DIFF(A.TS_AUT, B.TS_REF, MINUTE) AS DIFF_MIN), NULL)
        IGNORE NULLS ORDER BY A.TS_AUT ASC LIMIT 1
      )[SAFE_OFFSET(0)] AS AUT_AFTER,
      ARRAY_AGG(
        IF(B.HAS_REF_IN_WINDOW = 1 AND A.TS_AUT > B.TS_REF AND A.TS_AUT <= B.TS_HIGH AND DATE(A.TS_AUT) = B.REF_FECHA AND A.RESP_AUT = 'AUTENTICACION EXITOSA', STRUCT(A.TS_AUT AS TS_AUT, A.RESP_AUT AS RESP_AUT, DATETIME_DIFF(A.TS_AUT, B.TS_REF, MINUTE) AS DIFF_MIN), NULL)
        IGNORE NULLS ORDER BY A.TS_AUT ASC LIMIT 1
      )[SAFE_OFFSET(0)] AS AUT_AFTER_OK,
      STRING_AGG(
        IF(A.TS_AUT BETWEEN B.TS_LOW AND B.TS_REF AND DATE(A.TS_AUT) = B.REF_FECHA, FORMAT('%s %s', FORMAT_DATETIME('%H:%M', A.TS_AUT), A.RESP_AUT), NULL),
        ' > ' ORDER BY A.TS_AUT ASC LIMIT 5
      ) AS AUT_BEFORE_PATH,
      STRING_AGG(
        IF(B.HAS_REF_IN_WINDOW = 1 AND A.TS_AUT > B.TS_REF AND A.TS_AUT <= B.TS_HIGH AND DATE(A.TS_AUT) = B.REF_FECHA, FORMAT('%s %s', FORMAT_DATETIME('%H:%M', A.TS_AUT), A.RESP_AUT), NULL),
        ' > ' ORDER BY A.TS_AUT ASC LIMIT 5
      ) AS AUT_AFTER_PATH,
      COUNTIF(A.TS_AUT BETWEEN B.TS_LOW AND B.TS_REF AND DATE(A.TS_AUT) = B.REF_FECHA) AS AUT_BEFORE_CNT,
      COUNTIF(A.TS_AUT BETWEEN B.TS_LOW AND B.TS_REF AND DATE(A.TS_AUT) = B.REF_FECHA AND A.RESP_AUT = 'AUTENTICACION EXITOSA') AS AUT_BEFORE_OK_CNT,
      COUNTIF(B.HAS_REF_IN_WINDOW = 1 AND A.TS_AUT > B.TS_REF AND A.TS_AUT <= B.TS_HIGH AND DATE(A.TS_AUT) = B.REF_FECHA) AS AUT_AFTER_CNT,
      COUNTIF(B.HAS_REF_IN_WINDOW = 1 AND A.TS_AUT > B.TS_REF AND A.TS_AUT <= B.TS_HIGH AND DATE(A.TS_AUT) = B.REF_FECHA AND A.RESP_AUT = 'AUTENTICACION EXITOSA') AS AUT_AFTER_OK_CNT
    FROM ROW_KEYS AS B
    LEFT JOIN BIO_AUT_KEYS AS A
      ON B.TYPE = A.TYPE AND B.KEY_VAL = A.KEY_VAL AND IF(B.TYPE = 'NAME_DOB', B.DOB6, '') = A.KEY_DOB6
    GROUP BY B.ID_ROW, B.TYPE, B.SRC, B.KEY_VAL, B.DOB6
  ),
  KEY_STATUS_BASE AS (
    SELECT
      E.ID_ROW, E.TYPE, E.SRC, E.KEY_VAL, E.DOB6, O.BLOQ2,
      H.HAS_ENR_HIST_ANY, H.ENR_HIST_LAST_ANY,
      E.ENR_BEFORE, E.ENR_AFTER, E.ENR_BEFORE_CNT, E.ENR_BEFORE_OK_CNT, E.ENR_AFTER_CNT, E.ENR_AFTER_OK_CNT, E.ENR_BEFORE_PATH, E.ENR_AFTER_PATH, E.ENR_BEFORE_OK, E.ENR_AFTER_OK,
      A.AUT_BEFORE, A.AUT_AFTER, A.AUT_BEFORE_OK, A.AUT_AFTER_OK, A.AUT_BEFORE_CNT, A.AUT_BEFORE_OK_CNT, A.AUT_AFTER_CNT, A.AUT_AFTER_OK_CNT, A.AUT_BEFORE_PATH, A.AUT_AFTER_PATH,
      IF(E.ENR_BEFORE.TS_ENR IS NOT NULL OR E.ENR_AFTER.TS_ENR IS NOT NULL OR A.AUT_BEFORE.TS_AUT IS NOT NULL OR A.AUT_AFTER.TS_AUT IS NOT NULL, 1, 0) AS FLG_BIO_REALIZADO
    FROM ENR_MET AS E
    LEFT JOIN ENR_HIST_MET AS H ON E.ID_ROW = H.ID_ROW AND E.TYPE = H.TYPE AND E.SRC = H.SRC AND E.KEY_VAL = H.KEY_VAL AND SAFE_CAST(E.DOB6 AS STRING) = SAFE_CAST(H.DOB6 AS STRING)
    LEFT JOIN AUT_MET AS A ON E.ID_ROW = A.ID_ROW AND E.TYPE = A.TYPE AND E.SRC = A.SRC AND E.KEY_VAL = A.KEY_VAL AND SAFE_CAST(E.DOB6 AS STRING) = SAFE_CAST(A.DOB6 AS STRING)
    LEFT JOIN (SELECT DISTINCT ID_ROW, BLOQ2 FROM BIO_OP) AS O ON E.ID_ROW = O.ID_ROW
  ),
  KEY_STATUS AS (
    SELECT
      *,
      CASE
        WHEN FLG_BIO_REALIZADO = 0 AND IFNULL(HAS_ENR_HIST_ANY, FALSE) THEN 'NO AUTENTICARON HUELLA (TENIA ENROLAMIENTO)'
        WHEN FLG_BIO_REALIZADO = 0 THEN 'SIN REGISTRO'
        WHEN ENR_BEFORE_OK.TS_ENR IS NOT NULL THEN 'BIOMETRICO OK'
        WHEN AUT_BEFORE_OK.TS_AUT IS NOT NULL THEN 'BIOMETRICO OK'
        WHEN AUT_AFTER_OK.TS_AUT IS NOT NULL AND ENR_AFTER_OK.TS_ENR IS NOT NULL AND ENR_AFTER_OK.TS_ENR > AUT_AFTER_OK.TS_AUT AND NOT REGEXP_CONTAINS(IFNULL(BLOQ2, ''), r'F#') THEN 'REENROLA (EXITOSO)'
        WHEN AUT_AFTER_OK.TS_AUT IS NOT NULL AND ENR_AFTER_OK.TS_ENR IS NOT NULL AND ENR_AFTER_OK.TS_ENR > AUT_AFTER_OK.TS_AUT AND REGEXP_CONTAINS(IFNULL(BLOQ2, ''), r'F#') THEN 'REENROLA (NO EXITOSO)'
        WHEN AUT_AFTER_OK.TS_AUT IS NOT NULL THEN 'AUTENTICA DESPUES DEL EVENTO (EXITOSO)'
        WHEN ENR_AFTER_OK.TS_ENR IS NOT NULL THEN 'ENROLA DESPUES DEL EVENTO (EXITOSO)'
        WHEN ENR_BEFORE.TS_ENR IS NOT NULL THEN 'REGISTRO FALLIDO'
        WHEN AUT_BEFORE.TS_AUT IS NOT NULL THEN 'AUTENTICACION FALLIDA'
        WHEN AUT_AFTER.TS_AUT IS NOT NULL AND ENR_AFTER.TS_ENR IS NOT NULL AND ENR_AFTER.TS_ENR > AUT_AFTER.TS_AUT AND REGEXP_CONTAINS(IFNULL(BLOQ2, ''), r'F#') THEN 'REENROLA (NO EXITOSO)'
        WHEN AUT_AFTER.TS_AUT IS NOT NULL THEN 'AUTENTICA DESPUES DEL EVENTO (FALLIDO)'
        WHEN ENR_AFTER.TS_ENR IS NOT NULL THEN 'ENROLA DESPUES DEL EVENTO (FALLIDO)'
        ELSE 'SIN REGISTRO'
      END AS MATCH_BIO_STT,
      CASE
        WHEN FLG_BIO_REALIZADO = 0 AND IFNULL(HAS_ENR_HIST_ANY, FALSE) THEN 10
        WHEN FLG_BIO_REALIZADO = 0 THEN 11
        WHEN ENR_BEFORE_OK.TS_ENR IS NOT NULL THEN 1
        WHEN AUT_BEFORE_OK.TS_AUT IS NOT NULL THEN 1
        WHEN AUT_AFTER_OK.TS_AUT IS NOT NULL AND ENR_AFTER_OK.TS_ENR IS NOT NULL AND ENR_AFTER_OK.TS_ENR > AUT_AFTER_OK.TS_AUT AND NOT REGEXP_CONTAINS(IFNULL(BLOQ2, ''), r'F#') THEN 2
        WHEN AUT_AFTER_OK.TS_AUT IS NOT NULL THEN 3
        WHEN ENR_AFTER_OK.TS_ENR IS NOT NULL THEN 4
        WHEN ENR_BEFORE.TS_ENR IS NOT NULL THEN 5
        WHEN AUT_BEFORE.TS_AUT IS NOT NULL THEN 6
        WHEN AUT_AFTER.TS_AUT IS NOT NULL AND ENR_AFTER_OK.TS_ENR IS NOT NULL AND ENR_AFTER_OK.TS_ENR > AUT_AFTER.TS_AUT AND REGEXP_CONTAINS(IFNULL(BLOQ2, ''), r'F#') THEN 7
        WHEN AUT_AFTER.TS_AUT IS NOT NULL THEN 8
        WHEN ENR_AFTER.TS_ENR IS NOT NULL THEN 9
        ELSE 99
      END AS STT_ORD
    FROM KEY_STATUS_BASE
  ),
  BEST_PER_ROW AS (
    SELECT * FROM KEY_STATUS
    QUALIFY ROW_NUMBER() OVER (
      PARTITION BY ID_ROW
      ORDER BY STT_ORD,
        CASE SRC
          WHEN 'FICO_RFC10' THEN 1
          WHEN 'APIA_RFC10' THEN 2
          WHEN 'VPL_RFC10' THEN 3
          WHEN 'VPL_CURP18' THEN 4
          WHEN 'APIA_CURP18' THEN 5
          ELSE 9
        END
    ) = 1
  )
  SELECT
    O.ID_ROW,
    O.CTA_CVE,
    O.TRJ_NUM,
    IFNULL(B.FLG_BIO_REALIZADO, 0) AS FLG_BIO_REALIZADO_NUM,
    B.MATCH_BIO_STT,
    TO_JSON_STRING(STRUCT(
      IFNULL(B.FLG_BIO_REALIZADO, 0) AS flg_bio_realizado,
      FORMAT_DATE('%F', O.REF_FECHA) AS fecha_referencia,
      CAST(O.REF_HORA AS STRING) AS hora_referencia,
      COALESCE(FORMAT_DATETIME('%F %T', O.TS_LOW), '') AS ventana_inicio,
      COALESCE(FORMAT_DATETIME('%F %T', O.TS_HIGH), '') AS ventana_fin,
      O.HAS_REF_IN_WINDOW AS dentro_horario,
      O.CNT_KEYS AS total_llaves,
      IFNULL(B.HAS_ENR_HIST_ANY, FALSE) AS tiene_enrolamiento_historico,
      COALESCE(FORMAT_DATETIME('%F %T', B.ENR_HIST_LAST_ANY.TS_ENR), '') AS ultimo_enrolamiento_historico_ts,
      COALESCE(B.ENR_HIST_LAST_ANY.DIFF_MIN, 0) AS minutos_desde_ultimo_enrolamiento,
      COALESCE(B.ENR_HIST_LAST_ANY.DIFF_DAY, 0) AS dias_desde_ultimo_enrolamiento
    )) AS TRJ_BIO_REALIZADO_LOG_JSON,
    TO_JSON_STRING(STRUCT(
      B.MATCH_BIO_STT AS estatus_biometrico,
      B.SRC AS fuente_llave_match,
      B.TYPE AS tipo_llave,
      B.ENR_BEFORE_CNT AS cantidad_enrolamientos_antes,
      B.ENR_BEFORE_OK_CNT AS cantidad_enrolamientos_exitosos_antes,
      B.AUT_BEFORE_CNT AS cantidad_autenticaciones_antes,
      B.AUT_BEFORE_OK_CNT AS cantidad_autenticaciones_exitosas_antes
    )) AS TRJ_BIO_LOG_JSON
  FROM BIO_OP AS O
  LEFT JOIN BEST_PER_ROW AS B ON O.ID_ROW = B.ID_ROW
  WHERE B.MATCH_BIO_STT IN ('NO AUTENTICARON HUELLA (TENIA ENROLAMIENTO)', 'SIN REGISTRO')
);

CREATE TEMP TABLE BIO_CTA AS (
  WITH CTA_LIST AS (
    SELECT DISTINCT UNIV_INI.CTA_CVE FROM BIO_TRJ_EVAL INNER JOIN UNIV_INI USING(TRJ_NUM) WHERE FLG_EMBO = 1
  ),
  KEY_STATS AS (
    SELECT CTA_CVE, COUNT(1) AS CNT_KEYS FROM BIO_KEYS GROUP BY CTA_CVE
  ),
  CTA_META AS (
    SELECT CTA_CVE, ANY_VALUE(CTE_CVE_UNICO) AS CTE_CVE_UNICO FROM UNIV_INI GROUP BY CTA_CVE
  ),
  ENR_MATCH_HIST AS (
    SELECT
      K.CTA_CVE, K.TYPE AS MATCH_TYPE, K.SRC AS MATCH_SRC, K.KEY_VAL AS MATCH_KEY, K.DOB6, E.TS_ENR, E.ENR_CURP18
    FROM BIO_KEYS AS K
    LEFT JOIN BIO_ERN_KEYS_HIST AS E ON K.TYPE = E.TYPE AND K.KEY_VAL = E.KEY_VAL AND IF(K.TYPE = 'NAME_DOB', K.DOB6, '') = E.KEY_DOB6
  ),
  CTA_SUMMARY AS (
    SELECT CTA_CVE, COUNTIF(TS_ENR IS NOT NULL) AS CNT_ENR_MATCH FROM ENR_MATCH_HIST GROUP BY CTA_CVE
  ),
  CTA_BEST AS (
    SELECT CTA_CVE, TS_ENR, ENR_CURP18, MATCH_TYPE, MATCH_SRC, MATCH_KEY FROM ENR_MATCH_HIST
    WHERE TS_ENR IS NOT NULL QUALIFY ROW_NUMBER() OVER (PARTITION BY CTA_CVE ORDER BY TS_ENR DESC) = 1
  )
  SELECT
    M.CTE_CVE_UNICO,
    L.CTA_CVE,
    B.ENR_CURP18 AS CTA_ENR_CURP18,
    IF(IFNULL(SU.CNT_ENR_MATCH, 0) > 0, TRUE, FALSE) AS CTA_ENR_EXISTE_BOOL,
    TO_JSON_STRING(STRUCT(
      B.ENR_CURP18 AS cta_enr_curp18,
      IF(IFNULL(SU.CNT_ENR_MATCH, 0) > 0, TRUE, FALSE) AS existe_enrolamiento,
      CASE
        WHEN IFNULL(KS.CNT_KEYS, 0) = 0 THEN 'NO KEYS'
        WHEN IFNULL(SU.CNT_ENR_MATCH, 0) = 0 THEN 'SIN ENROLAMIENTO HISTORICO'
        ELSE FORMAT('ULTIMO=%s | MATCH=%s/%s | KEY=%s', FORMAT_DATETIME('%F %T', B.TS_ENR), COALESCE(B.MATCH_TYPE, ''), COALESCE(B.MATCH_SRC, ''), COALESCE(B.MATCH_KEY, ''))
      END AS detalle_log
    )) AS CTA_ENR_LOG_JSON
  FROM CTA_LIST AS L
  LEFT JOIN KEY_STATS AS KS ON L.CTA_CVE = KS.CTA_CVE
  LEFT JOIN CTA_SUMMARY AS SU ON L.CTA_CVE = SU.CTA_CVE
  LEFT JOIN CTA_BEST AS B ON L.CTA_CVE = B.CTA_CVE
  LEFT JOIN CTA_META AS M ON L.CTA_CVE = M.CTA_CVE
);

-- ============================================================
-- 5. CÁLCULO DE INVESTIGACIONES Y MULTICUENTAS (MATCH_INV)
-- ============================================================
CREATE TEMP TABLE MATCH_INV_METRICS AS (
  WITH CURP_ENR_U AS (
    SELECT DISTINCT CTA_ENR_CURP18 AS CURP18 FROM BIO_CTA WHERE CTA_ENR_CURP18 IS NOT NULL AND IS_CURP18(CTA_ENR_CURP18)
    UNION DISTINCT
    SELECT DISTINCT APIA_CURP AS CURP18 FROM SOLICITUDES_ALL WHERE APIA_CURP IS NOT NULL AND IS_CURP18(APIA_CURP)
  ),
  APIA_CURP AS (
    SELECT DISTINCT
      NORM_CURP18(A.BR_CURP) AS CURP18,
      NULLIF(SAFE_CAST(A.BR_SOLIC_CVE AS NUMERIC), 0) AS BR_SOLIC_CVE,
      SUBSTR(SAFE_CAST(A.BR_TIPO AS STRING), 1, 3) AS BR_TIPO_3,
      SAFE_CAST(A.BR_ORG AS STRING) AS TIP_INF,
      TRIM(A.BR_RFC) AS RFC_APIA
    FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VFAC_APIA` AS A
    INNER JOIN CURP_ENR_U AS U ON NORM_CURP18(A.BR_CURP) = U.CURP18
    WHERE NORM_CURP18(A.BR_CURP) IS NOT NULL
  ),
  APIA_SDO AS (
    SELECT
      A.CURP18, S.CTA_CVE, S.CTA_SDO_ACT, S.CTA_IMP_LIM_CRD,
      SAFE_DIVIDE(S.CTA_SDO_ACT, NULLIF(S.CTA_IMP_LIM_CRD, 0)) AS PCT_USO,
      A.BR_SOLIC_CVE, A.BR_TIPO_3, A.TIP_INF, A.RFC_APIA
    FROM APIA_CURP AS A
    INNER JOIN `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VFAC_SDO_CTA_MES` AS S
      ON A.BR_SOLIC_CVE = S.BR_SOLIC_CVE AND A.BR_TIPO_3 = SUBSTR(SAFE_CAST(S.BR_TIPO AS STRING), 1, 3) AND A.TIP_INF = SAFE_CAST(S.TIP_INF AS STRING) 
    WHERE S.ANIO = CUR_ANIO AND S.MES = CUR_MES
  ),
  FICO_INV AS (
    SELECT DISTINCT
      NULLIF(SAFE_CAST(A.BR_SOLIC_CVE AS NUMERIC), 0) AS BR_SOLIC_CVE,
      TRIM(A.BR_RFC) AS FICO_RFC
    FROM `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_REP_SOL_FICO` AS A
    INNER JOIN (SELECT DISTINCT BR_SOLIC_CVE FROM APIA_SDO WHERE BR_SOLIC_CVE IS NOT NULL) AS U ON NULLIF(SAFE_CAST(A.BR_SOLIC_CVE AS NUMERIC), 0) = U.BR_SOLIC_CVE
  ),
  CLIE_FTES_CLEAN AS (
    SELECT DISTINCT
      A.CTA_CVE,
      CONCAT(TRIM(COALESCE(CTE_NOM, "")), " ", TRIM(COALESCE(CTE_APE_PAT, "")), " ", TRIM(COALESCE(CTE_APE_MAT, ""))) AS NOMBRE,
      IF(REGEXP_CONTAINS(TRIM(CTE_CVE_RFC), r"^0+"), NULL, SUBSTR(TRIM(CTE_CVE_RFC), 1, 13)) AS CTE_CVE_RFC,
      SAFE_CAST(SUBSTR(ZEROS_TO_NULL(CAST(CTE_TEL AS STRING)), -10) AS NUMERIC) AS TEL,
      SAFE_CAST(SUBSTR(ZEROS_TO_NULL(CAST(CTE_CEL AS STRING)), -10) AS NUMERIC) AS CEL,
      UPPER(TRIM(CTE_EMA)) AS EMAIL,
      SAFE_CAST(CDP_CVE AS STRING) AS CDP_CVE,
      SEX_CVE AS SEXO,
      CTE_FCH_NAC AS FCH_NAC,
      CTE_FCH_ALT AS FCH_APERTURA
    FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CLIE_FTES_VPL` AS A
    INNER JOIN (SELECT DISTINCT CTA_CVE FROM APIA_SDO) AS K ON A.CTA_CVE = K.CTA_CVE
  ),
  MATCH_INV_RAW AS (
    SELECT
      A.CURP18, B.CTE_CVE_UNICO, A.BR_SOLIC_CVE, A.CTA_CVE, A.PCT_USO, A.CTA_SDO_ACT, A.CTA_IMP_LIM_CRD,
      F.NOMBRE, F.CTE_CVE_RFC, FI.FICO_RFC, A.RFC_APIA, F.EMAIL, F.CEL, F.CDP_CVE, F.SEXO, F.FCH_NAC, F.FCH_APERTURA
    FROM APIA_SDO AS A
    LEFT JOIN CLIE_FTES_CLEAN AS F ON F.CTA_CVE = A.CTA_CVE
    LEFT JOIN FICO_INV AS FI ON FI.BR_SOLIC_CVE = A.BR_SOLIC_CVE
    LEFT JOIN (
      SELECT DISTINCT CTE_CVE_UNICO, CTA_CVE 
      FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CTA_TRJ` 
      WHERE CTA_CVE IN (SELECT DISTINCT CTA_CVE FROM UNIV_INI)
    ) AS B ON A.CTA_CVE = B.CTA_CVE
  ),
  MATCH_INV_DEDUP AS (
    SELECT * FROM MATCH_INV_RAW QUALIFY ROW_NUMBER() OVER (PARTITION BY CURP18, CTA_CVE ORDER BY PCT_USO DESC, CTA_SDO_ACT DESC) = 1
  ),
  BASE_CONTACTS AS (
    SELECT DISTINCT CTA_CVE, NULLIF(UPPER(TRIM(EMAIL)), '') AS EMAIL_CLEAN, CEL AS CEL_CLEAN FROM CLIE_FTES_ALL
  ),
  MATCH_INV_CONTACTS AS (
    SELECT DISTINCT CTA_CVE, NULLIF(UPPER(TRIM(EMAIL)), '') AS EMAIL_CLEAN, CEL AS CEL_CLEAN FROM MATCH_INV_DEDUP
  ),
  CONTACTS_EMAIL_TO_CHECK AS (
    SELECT DISTINCT EMAIL_CLEAN FROM (SELECT EMAIL_CLEAN FROM BASE_CONTACTS UNION DISTINCT SELECT EMAIL_CLEAN FROM MATCH_INV_CONTACTS) WHERE EMAIL_CLEAN IS NOT NULL
  ),
  CONTACTS_CEL_TO_CHECK AS (
    SELECT DISTINCT CEL_CLEAN FROM (SELECT CEL_CLEAN FROM BASE_CONTACTS UNION DISTINCT SELECT CEL_CLEAN FROM MATCH_INV_CONTACTS) WHERE CEL_CLEAN IS NOT NULL
  ),
  CLIE_FTES_EMAIL_RFC_GT1 AS (
    SELECT EMAIL_CLEAN, COUNT(DISTINCT CTE_CVE_RFC_CLEAN) AS CNT_RFC_DIST_X_EMAIL
    FROM (
      SELECT
        NULLIF(UPPER(TRIM(CTE_EMA)), '') AS EMAIL_CLEAN,
        NULLIF(UPPER(TRIM(IF(REGEXP_CONTAINS(TRIM(IFNULL(CTE_CVE_RFC, '')), r'^0+'), NULL, SUBSTR(TRIM(CTE_CVE_RFC), 1, 13)))), '') AS CTE_CVE_RFC_CLEAN
      FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CLIE_FTES_VPL`
      WHERE NULLIF(UPPER(TRIM(CTE_EMA)), '') IN (SELECT EMAIL_CLEAN FROM CONTACTS_EMAIL_TO_CHECK)
    )
    WHERE EMAIL_CLEAN IS NOT NULL AND CTE_CVE_RFC_CLEAN IS NOT NULL
    GROUP BY EMAIL_CLEAN HAVING COUNT(DISTINCT CTE_CVE_RFC_CLEAN) > 1
  ),
  CLIE_FTES_CEL_RFC_GT1 AS (
    SELECT CEL_CLEAN, COUNT(DISTINCT CTE_CVE_RFC_CLEAN) AS CNT_RFC_DIST_X_CEL
    FROM (
      SELECT
        SAFE_CAST(SUBSTR(ZEROS_TO_NULL(CAST(CTE_CEL AS STRING)), -10) AS NUMERIC) AS CEL_CLEAN,
        NULLIF(UPPER(TRIM(IF(REGEXP_CONTAINS(TRIM(IFNULL(CTE_CVE_RFC, '')), r'^0+'), NULL, SUBSTR(TRIM(CTE_CVE_RFC), 1, 13)))), '') AS CTE_CVE_RFC_CLEAN
      FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CLIE_FTES_VPL`
      WHERE SAFE_CAST(SUBSTR(ZEROS_TO_NULL(CAST(CTE_CEL AS STRING)), -10) AS NUMERIC) IN (SELECT CEL_CLEAN FROM CONTACTS_CEL_TO_CHECK)
    )
    WHERE CEL_CLEAN IS NOT NULL AND CTE_CVE_RFC_CLEAN IS NOT NULL
    GROUP BY CEL_CLEAN HAVING COUNT(DISTINCT CTE_CVE_RFC_CLEAN) > 1
  )
  SELECT DISTINCT
    COALESCE(C.CTA_CVE, B.CTA_CVE) AS BASE_CTA_CVE,
    COALESCE(C.CTA_ENR_CURP18, S.APIA_CURP) AS CURP18,
    NULLIF(COUNT(I.CTA_CVE), 0) AS CNT_CTA_INV,
    MAX(EI.CNT_RFC_DIST_X_EMAIL) AS MATCH_INV_CNT_RFC_DIST_X_EMAIL_GT1,
    MAX(CI.CNT_RFC_DIST_X_CEL) AS MATCH_INV_CNT_RFC_DIST_X_CEL_GT1,
    STRING_AGG(
      DISTINCT IF(I.CTA_CVE IS NULL, NULL,
        FORMAT('CVE_UNI=%s | BR_SOL=%s | CTA=%s\nUSO=%.2f%% | SDO=%s | LIM=%s\nNOM=%s | RFC=%s\nEMAIL=%s | CEL=%s | CDP=%s',
          COALESCE(CAST(I.CTE_CVE_UNICO AS STRING), ''), COALESCE(CAST(I.BR_SOLIC_CVE AS STRING), ''), CAST(I.CTA_CVE AS STRING),
          100 * IFNULL(I.PCT_USO, 0), COALESCE(CAST(I.CTA_SDO_ACT AS STRING), ''), COALESCE(CAST(I.CTA_IMP_LIM_CRD AS STRING), ''),
          COALESCE(I.NOMBRE, ''), COALESCE(I.CTE_CVE_RFC, ''), COALESCE(I.EMAIL, ''), COALESCE(CAST(I.CEL AS STRING), ''), COALESCE(I.CDP_CVE, '')
        )
      ), '\n'
    ) AS MATCH_INV_LOG
  FROM (SELECT DISTINCT CTA_CVE, CTE_CVE_UNICO FROM UNIV_INI) AS B
  LEFT JOIN (SELECT DISTINCT CTA_CVE, CTE_CVE_UNICO, CTA_ENR_CURP18 FROM BIO_CTA) AS C ON B.CTA_CVE = C.CTA_CVE
  LEFT JOIN (SELECT DISTINCT CTA_CVE, APIA_CURP FROM SOLICITUDES_ALL) AS S ON B.CTA_CVE = S.CTA_CVE
  LEFT JOIN MATCH_INV_DEDUP AS I
    ON I.CURP18 = COALESCE(C.CTA_ENR_CURP18, S.APIA_CURP)
   AND I.CTE_CVE_UNICO != COALESCE(C.CTE_CVE_UNICO, B.CTE_CVE_UNICO)
  LEFT JOIN CLIE_FTES_EMAIL_RFC_GT1 AS EI ON NULLIF(UPPER(TRIM(I.EMAIL)), '') = EI.EMAIL_CLEAN
  LEFT JOIN CLIE_FTES_CEL_RFC_GT1 AS CI ON I.CEL = CI.CEL_CLEAN
  WHERE COALESCE(C.CTA_ENR_CURP18, S.APIA_CURP) IS NOT NULL
  GROUP BY BASE_CTA_CVE, CURP18
);

-- ============================================================
-- 6. MOTOR BFS DECLARATIVO A 2 PASOS (CON TABLAS STAGING CLUSTERIZADAS)
-- ============================================================

-- A) Semillas Nivel 0 (Extracción directa desde Staging filtrada por el Universo)
CREATE TEMP TABLE BFS_SEEDS_LVL0 AS (
  SELECT DISTINCT
    K.CTA_CVE AS ROOT_CTA,
    K.SRC AS ROOT_SRC,
    K.K_TYPE,
    K.K_FIELD,
    K.K_VAL,
    K.NOMBRE AS ROOT_NOMBRE,
    K.APE_PAT AS ROOT_APE_PAT,
    K.CDP_CVE AS ROOT_CDP,
    K.ES_SUPERNODO
  FROM `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CONTACT_KEYS` AS K
  INNER JOIN (SELECT DISTINCT CTA_CVE FROM UNIV_INI) AS U 
    ON K.CTA_CVE = U.CTA_CVE
  WHERE K.CTA_CVE > 0
);

-- B) Salto 1 (Depth = 1): Búsqueda Directa a Cuentas de Crédito, Solicitudes y Pocket
CREATE TEMP TABLE BFS_HOP1_CTAS AS (
  SELECT
    ROOT_CTA,
    1 AS DEPTH,
    SRC_ORIGEN,
    SRC_DESTINO,
    CAMPO_CONEXION_ORIGEN,
    CAMPO_CONEXION_DESTINO,
    VALOR_CONEXION,
    CTA_DESTINO,
    NOMBRE_DESTINO,
    APE_PAT_DESTINO,
    CDP_DESTINO,
    ES_MISMO_APELLIDO,
    ES_MISMO_CP,
    IF(
      CTA_DESTINO < 0,
      CONCAT('[SEED CTA=', CAST(ROOT_CTA AS STRING), ' | ', CAMPO_CONEXION_ORIGEN, '=', VALOR_CONEXION, '] -> [HOP 1 APIA (SOLICITUD=', CAST(ABS(CTA_DESTINO) AS STRING), ') | ', CAMPO_CONEXION_DESTINO, ']'),
      CONCAT('[SEED CTA=', CAST(ROOT_CTA AS STRING), ' | ', CAMPO_CONEXION_ORIGEN, '=', VALOR_CONEXION, '] -> [HOP 1 ', SRC_DESTINO, '.', CAMPO_CONEXION_DESTINO, ' | CTA=', CAST(CTA_DESTINO AS STRING), ']')
    ) AS TRACE_PATH
  FROM (
    SELECT
      S.ROOT_CTA,
      S.ROOT_SRC AS SRC_ORIGEN,
      K.SRC AS SRC_DESTINO,
      S.K_FIELD AS CAMPO_CONEXION_ORIGEN,
      K.K_FIELD AS CAMPO_CONEXION_DESTINO,
      S.K_VAL AS VALOR_CONEXION,
      K.CTA_CVE AS CTA_DESTINO,
      K.NOMBRE AS NOMBRE_DESTINO,
      K.APE_PAT AS APE_PAT_DESTINO,
      K.CDP_CVE AS CDP_DESTINO,
      IF(S.ROOT_APE_PAT != '' AND K.APE_PAT != '' AND S.ROOT_APE_PAT = K.APE_PAT, TRUE, FALSE) AS ES_MISMO_APELLIDO,
      IF(S.ROOT_CDP != '' AND K.CDP_CVE != '' AND S.ROOT_CDP = K.CDP_CVE, TRUE, FALSE) AS ES_MISMO_CP,
      ROW_NUMBER() OVER(
        PARTITION BY S.ROOT_CTA, K.CTA_CVE 
        ORDER BY IF(S.ROOT_APE_PAT = K.APE_PAT, 1, 2), K.DEGREE_CNT ASC
      ) AS RN_CTA,
      ROW_NUMBER() OVER(
        PARTITION BY S.ROOT_CTA 
        ORDER BY IF(S.ROOT_APE_PAT = K.APE_PAT, 1, 2), K.DEGREE_CNT ASC
      ) AS RN_LIMIT_PER_ROOT
    FROM BFS_SEEDS_LVL0 AS S
    JOIN `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CONTACT_KEYS` AS K
      ON S.K_TYPE = K.K_TYPE
     AND S.K_VAL = K.K_VAL
     AND S.ROOT_CTA != K.CTA_CVE
    WHERE S.ES_SUPERNODO = FALSE
      AND K.ES_SUPERNODO = FALSE
      AND K.CTA_CVE != 0
  )
  WHERE RN_CTA = 1 AND RN_LIMIT_PER_ROOT <= 25
);

CREATE TEMP TABLE BFS_HOP1_POCKET AS (
  SELECT DISTINCT
    S.ROOT_CTA,
    1 AS DEPTH,
    S.ROOT_SRC AS SRC_ORIGEN,
    'CUSTOMERS' AS SRC_DESTINO,
    S.K_FIELD AS CAMPO_CONEXION_ORIGEN,
    C.K_FIELD AS CAMPO_CONEXION_DESTINO,
    S.K_VAL AS VALOR_CONEXION,
    C.ID_CUSTOMERS,
    C.MON_DIG,
    C.FCH_ALTA AS FCH_ALTA_POCKET,
    C.NOMBRE AS NOMBRE_DESTINO,
    IF(S.ROOT_APE_PAT != '' AND C.APE_PAT != '' AND S.ROOT_APE_PAT = C.APE_PAT, TRUE, FALSE) AS ES_MISMO_APELLIDO,
    CONCAT('[SEED CTA=', CAST(S.ROOT_CTA AS STRING), ' | ', S.K_FIELD, '=', S.K_VAL, '] -> [HOP 1 CUSTOMER.', C.K_FIELD, ' | ID=', C.ID_CUSTOMERS, ']') AS TRACE_PATH
  FROM BFS_SEEDS_LVL0 AS S
  JOIN `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CUSTOMER_KEYS` AS C
    ON S.K_TYPE = C.K_TYPE
   AND S.K_VAL = C.K_VAL
  WHERE S.ES_SUPERNODO = FALSE
  QUALIFY ROW_NUMBER() OVER(PARTITION BY S.ROOT_CTA, C.ID_CUSTOMERS ORDER BY C.FCH_ALTA DESC) = 1
);

-- C) Salto 2 (Depth = 2): Expansión Filtrada con Semi-Join Pushdown
CREATE TEMP TABLE BFS_SEEDS_LVL1 AS (
  SELECT DISTINCT
    H.ROOT_CTA,
    H.CTA_DESTINO AS HOP1_CTA,
    K.SRC AS HOP1_SRC,
    K.K_TYPE,
    K.K_FIELD,
    K.K_VAL,
    K.NOMBRE,
    K.APE_PAT,
    K.CDP_CVE,
    H.TRACE_PATH
  FROM BFS_HOP1_CTAS AS H
  JOIN `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CONTACT_KEYS` AS K 
    ON H.CTA_DESTINO = K.CTA_CVE
  WHERE K.ES_SUPERNODO = FALSE
    AND H.CTA_DESTINO != 0
    AND K.CTA_CVE != 0
);

CREATE TEMP TABLE BFS_KEYS_TARGET_HOP2 AS (
  SELECT K.*
  FROM `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CONTACT_KEYS` AS K
  WHERE K.ES_SUPERNODO = FALSE
    AND K.CTA_CVE != 0
    AND EXISTS (
      SELECT 1 FROM BFS_SEEDS_LVL1 AS S
      WHERE S.K_TYPE = K.K_TYPE AND S.K_VAL = K.K_VAL
    )
);

CREATE TEMP TABLE BFS_HOP2_CTAS AS (
  SELECT
    ROOT_CTA,
    2 AS DEPTH,
    SRC_ORIGEN,
    SRC_DESTINO,
    CAMPO_CONEXION_ORIGEN,
    CAMPO_CONEXION_DESTINO,
    VALOR_CONEXION,
    CTA_DESTINO,
    NOMBRE_DESTINO,
    APE_PAT_DESTINO,
    CDP_DESTINO,
    ES_MISMO_APELLIDO,
    ES_MISMO_CP,
    IF(
      CTA_DESTINO < 0,
      CONCAT(TRACE_PATH, ' -> [HOP 2 APIA (SOLICITUD=', CAST(ABS(CTA_DESTINO) AS STRING), ') | ', CAMPO_CONEXION_DESTINO, ']'),
      CONCAT(TRACE_PATH, ' -> [HOP 2 ', SRC_DESTINO, '.', CAMPO_CONEXION_DESTINO, ' | CTA=', CAST(CTA_DESTINO AS STRING), ']')
    ) AS TRACE_PATH
  FROM (
    SELECT
      S.ROOT_CTA,
      S.HOP1_SRC AS SRC_ORIGEN,
      K.SRC AS SRC_DESTINO,
      S.K_FIELD AS CAMPO_CONEXION_ORIGEN,
      K.K_FIELD AS CAMPO_CONEXION_DESTINO,
      S.K_VAL AS VALOR_CONEXION,
      K.CTA_CVE AS CTA_DESTINO,
      K.NOMBRE AS NOMBRE_DESTINO,
      K.APE_PAT AS APE_PAT_DESTINO,
      K.CDP_CVE AS CDP_DESTINO,
      IF(S.APE_PAT != '' AND K.APE_PAT != '' AND S.APE_PAT = K.APE_PAT, TRUE, FALSE) AS ES_MISMO_APELLIDO,
      IF(S.CDP_CVE != '' AND K.CDP_CVE != '' AND S.CDP_CVE = K.CDP_CVE, TRUE, FALSE) AS ES_MISMO_CP,
      S.TRACE_PATH,
      ROW_NUMBER() OVER(
        PARTITION BY S.ROOT_CTA, K.CTA_CVE 
        ORDER BY IF(S.APE_PAT = K.APE_PAT, 1, 2), K.DEGREE_CNT ASC
      ) AS RN_CTA,
      ROW_NUMBER() OVER(
        PARTITION BY S.ROOT_CTA 
        ORDER BY IF(S.APE_PAT = K.APE_PAT, 1, 2), K.DEGREE_CNT ASC
      ) AS RN_LIMIT_PER_ROOT
    FROM BFS_SEEDS_LVL1 AS S
    JOIN BFS_KEYS_TARGET_HOP2 AS K
      ON S.K_TYPE = K.K_TYPE
     AND S.K_VAL = K.K_VAL
     AND S.ROOT_CTA != K.CTA_CVE
     AND S.HOP1_CTA != K.CTA_CVE
    WHERE K.CTA_CVE != 0
  )
  WHERE RN_CTA = 1 AND RN_LIMIT_PER_ROOT <= 35
);

CREATE TEMP TABLE BFS_HOP2_POCKET AS (
  SELECT DISTINCT
    S.ROOT_CTA,
    2 AS DEPTH,
    S.HOP1_SRC AS SRC_ORIGEN,
    'CUSTOMERS' AS SRC_DESTINO,
    S.K_FIELD AS CAMPO_CONEXION_ORIGEN,
    C.K_FIELD AS CAMPO_CONEXION_DESTINO,
    S.K_VAL AS VALOR_CONEXION,
    C.ID_CUSTOMERS,
    C.MON_DIG,
    C.FCH_ALTA AS FCH_ALTA_POCKET,
    C.NOMBRE AS NOMBRE_DESTINO,
    IF(S.APE_PAT != '' AND C.APE_PAT != '' AND S.APE_PAT = C.APE_PAT, TRUE, FALSE) AS ES_MISMO_APELLIDO,
    CONCAT(S.TRACE_PATH, ' -> [HOP 2 CUSTOMER.', C.K_FIELD, ' | ID=', C.ID_CUSTOMERS, ']') AS TRACE_PATH
  FROM BFS_SEEDS_LVL1 AS S
  JOIN `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CUSTOMER_KEYS` AS C
    ON S.K_TYPE = C.K_TYPE
   AND S.K_VAL = C.K_VAL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY S.ROOT_CTA, C.ID_CUSTOMERS ORDER BY C.FCH_ALTA DESC) = 1
);

-- D) Consolidación de Nodos Únicos
CREATE TEMP TABLE BFS_CONSOLIDATED_NODES AS (
  WITH RAW_UNION AS (
    SELECT ROOT_CTA, DEPTH, SRC_ORIGEN, SRC_DESTINO, CAMPO_CONEXION_ORIGEN, CAMPO_CONEXION_DESTINO, VALOR_CONEXION, CTA_DESTINO, NULL AS ID_CUSTOMERS, NULL AS MON_DIG, NOMBRE_DESTINO, ES_MISMO_APELLIDO, ES_MISMO_CP, TRACE_PATH
    FROM BFS_HOP1_CTAS
    UNION ALL
    SELECT ROOT_CTA, DEPTH, SRC_ORIGEN, SRC_DESTINO, CAMPO_CONEXION_ORIGEN, CAMPO_CONEXION_DESTINO, VALOR_CONEXION, NULL AS CTA_DESTINO, ID_CUSTOMERS, MON_DIG, NOMBRE_DESTINO, ES_MISMO_APELLIDO, FALSE AS ES_MISMO_CP, TRACE_PATH
    FROM BFS_HOP1_POCKET
    UNION ALL
    SELECT ROOT_CTA, DEPTH, SRC_ORIGEN, SRC_DESTINO, CAMPO_CONEXION_ORIGEN, CAMPO_CONEXION_DESTINO, VALOR_CONEXION, CTA_DESTINO, NULL AS ID_CUSTOMERS, NULL AS MON_DIG, NOMBRE_DESTINO, ES_MISMO_APELLIDO, ES_MISMO_CP, TRACE_PATH
    FROM BFS_HOP2_CTAS
    UNION ALL
    SELECT ROOT_CTA, DEPTH, SRC_ORIGEN, SRC_DESTINO, CAMPO_CONEXION_ORIGEN, CAMPO_CONEXION_DESTINO, VALOR_CONEXION, NULL AS CTA_DESTINO, ID_CUSTOMERS, MON_DIG, NOMBRE_DESTINO, ES_MISMO_APELLIDO, FALSE AS ES_MISMO_CP, TRACE_PATH
    FROM BFS_HOP2_POCKET
  )
  SELECT *
  FROM RAW_UNION
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY ROOT_CTA, COALESCE(IF(CTA_DESTINO > 0, CAST(CTA_DESTINO AS STRING), CONCAT('SOLIC_', CAST(ABS(CTA_DESTINO) AS STRING))), CONCAT('CUST_', ID_CUSTOMERS))
    ORDER BY DEPTH ASC, LENGTH(TRACE_PATH) ASC
  ) = 1
);

-- E) Cálculo de Métricas y Serialización JSON
CREATE TEMP TABLE BFS_FINAL_METRICS AS (
  WITH STATS_PER_ROOT AS (
    SELECT
      ROOT_CTA,
      COUNTIF(CTA_DESTINO > 0) AS TOTAL_CTAS_REL,
      COUNTIF(CTA_DESTINO < 0) AS TOTAL_SOLICITUDES_REL,
      COUNTIF(ID_CUSTOMERS IS NOT NULL) AS TOTAL_POCKET_REL,
      COUNTIF(CTA_DESTINO > 0 AND ES_MISMO_APELLIDO = FALSE AND ES_MISMO_CP = FALSE) AS CNT_SIN_PARENTESCO,
      COUNTIF(CTA_DESTINO > 0 AND ES_MISMO_APELLIDO = TRUE) AS CNT_CON_PARENTESCO,
      MAX(DEPTH) AS MAX_DEPTH
    FROM BFS_CONSOLIDATED_NODES
    GROUP BY ROOT_CTA
  ),
  AGG_JSON_PER_ROOT AS (
    SELECT
      ROOT_CTA,
      ARRAY_AGG(
        STRUCT(
          DEPTH AS salto,
          SRC_ORIGEN AS fuente_origen,
          SRC_DESTINO AS fuente_destino,
          CAMPO_CONEXION_ORIGEN AS campo_origen,
          CAMPO_CONEXION_DESTINO AS campo_destino,
          VALOR_CONEXION AS dato_contacto_compartido,
          IF(CTA_DESTINO > 0, CTA_DESTINO, NULL) AS cuenta_credito_destino,
          IF(CTA_DESTINO < 0, ABS(CTA_DESTINO), NULL) AS solicitud_origen_destino,
          ID_CUSTOMERS AS id_customer_pocket,
          MON_DIG AS monedero_digital_pocket,
          NOMBRE_DESTINO AS titular_destino,
          ES_MISMO_APELLIDO AS coincide_apellido,
          ES_MISMO_CP AS coincide_codigo_postal,
          TRACE_PATH AS traza_recorrido
        )
        ORDER BY DEPTH ASC, SRC_DESTINO ASC
        LIMIT 40
      ) AS TRAZAS_ARRAY
    FROM BFS_CONSOLIDATED_NODES
    GROUP BY ROOT_CTA
  )
  SELECT
    S.ROOT_CTA,
    S.TOTAL_CTAS_REL AS BFS_TOTAL_CTAS_REL,
    S.TOTAL_POCKET_REL AS BFS_TOTAL_POCKET_REL,
    S.MAX_DEPTH AS BFS_MAX_DEPTH,
    CASE
      WHEN S.TOTAL_CTAS_REL = 0 AND S.TOTAL_SOLICITUDES_REL = 0 AND S.TOTAL_POCKET_REL = 0 THEN 'SIN_VINCULOS'
      WHEN S.CNT_SIN_PARENTESCO >= 2 THEN 'PATRON_ANILLO_RIESGO'
      WHEN S.CNT_CON_PARENTESCO > 0 THEN 'POSIBLE_VINCULO_FAMILIAR'
      ELSE 'VINCULO_DIRECTO_DESCONOCIDO'
    END AS BFS_RESUMEN_RIESGO_RED,
    TO_JSON_STRING(STRUCT(
      S.TOTAL_CTAS_REL AS total_cuentas_credito_relacionadas,
      S.TOTAL_SOLICITUDES_REL AS total_solicitudes_origen_relacionadas,
      S.TOTAL_POCKET_REL AS total_cuentas_pocket_relacionadas,
      S.MAX_DEPTH AS profundidad_maxima_alcanzada,
      J.TRAZAS_ARRAY AS trazas_red_conexiones
    )) AS BFS_NETWORK_GRAPH_JSON
  FROM STATS_PER_ROOT AS S
  LEFT JOIN AGG_JSON_PER_ROOT AS J
    ON S.ROOT_CTA = J.ROOT_CTA
);


-- ============================================================
-- 7. ENSAMBLE FINAL DE TABLA MAESTRA
-- ============================================================
CREATE TEMP TABLE RESULT_FINAL AS (
  SELECT
    U.TRJ_NUM,
    U.USR_VPL_R05,
    U.USR_VPL_CREA,
    U.FCH_GENERACION,
    U.HRA_GENERACION,
    U.TRJ_EDO_CVE,
    U.BLQ_TRJ_CVE,
    U.RAZON_BLQ_TRJ_CVE,
    U.FLG_EMBO,

    TO_JSON_STRING(STRUCT(
      U.CTE_CVE_UNICO AS cte_cve_unico,
      U.CTA_CVE AS cta_cve_tarjeta,
      ARRAY(
        SELECT AS STRUCT
          C.CTA_CVE, C.NOMBRE, C.CTE_CVE_RFC, C.TEL, C.CEL, C.EMAIL, C.DIRECCION, C.CDP_CVE, C.SEXO,
          C.FCH_NAC, C.FCH_APERTURA, C.EMPLEO, C.TEL_OFI, C.NOM_CONYUGE, C.NOM_REF1, C.TEL_REF1, C.NOM_REF2, C.TEL_REF2
        FROM CLIE_FTES_ALL AS C
        WHERE C.CTE_CVE_UNICO = U.CTE_CVE_UNICO
      ) AS cuentas
    )) AS CLIE_FTES_JSON,

    TO_JSON_STRING(STRUCT(
      U.CTE_CVE_UNICO AS cte_cve_unico,
      ARRAY(
        SELECT AS STRUCT
          S.CTA_CVE, S.CTA_EDO_CVE, S.CTA_NIV_MOR, S.CTA_IMP_LIM_CRD, S.CTA_SDO_ACT, S.CTA_HIST_PAGOS,
          S.TDA_APE, S.BLOQ1, S.BLOQ2, S.CTA_DEV, S.CTA_PAG, S.CTA_IMP
        FROM SDO_CTA_ALL AS S
        WHERE S.CTE_CVE_UNICO = U.CTE_CVE_UNICO
      ) AS cuentas
    )) AS SDO_CTA_MES_JSON,

    TO_JSON_STRING(STRUCT(
      U.CTE_CVE_UNICO AS cte_cve_unico,
      ARRAY(
        SELECT AS STRUCT
          SO.CTA_CVE, SO.BR_SOLIC_CVE, SO.FCH_SOL, SO.HRA_SOL, SO.BRAND, SO.CL, SO.STT_FICO,
          SO.STT_SIMP_FICO, SO.FICO_RFC, SO.APIA_CURP, SO.APIA_RFC, SO.BR_TIPO_3, SO.TIP_INF
        FROM SOLICITUDES_ALL AS SO
        WHERE SO.CTE_CVE_UNICO = U.CTE_CVE_UNICO
      ) AS solicitudes
    )) AS SOLICITUDES_ORIGEN_JSON,

    T.MATCH_BIO_STT,
    IF(IFNULL(P.CTA_CVE, 0) > 0, TRUE, FALSE) AS FLG_PRTNCIA_MATCH,
    TO_JSON_STRING(STRUCT(
      P.CODIGO_ACCION AS codigo_accion,
      P.TDA_ATENCION AS tienda_atencion,
      P.ID_ATENCION AS id_atencion,
      P.FECHA AS fecha,
      P.HORA AS hora,
      P.EMAIL AS email,
      P.CEL AS celular
    )) AS PRTNCIA_LOG,
    CAST(T.FLG_BIO_REALIZADO_NUM AS BOOL) AS FLG_BIO_REALIZADO,
    PARSE_JSON(T.TRJ_BIO_REALIZADO_LOG_JSON) AS TRJ_BIO_REALIZADO_LOG,
    PARSE_JSON(T.TRJ_BIO_LOG_JSON) AS TRJ_BIO_LOG,

    C.CTA_ENR_EXISTE_BOOL AS CTA_ENR_EXISTE,
    PARSE_JSON(C.CTA_ENR_LOG_JSON) AS CTA_ENR_LOG,

    TO_JSON_STRING(STRUCT(
      M.CNT_CTA_INV AS cnt_cta_inv,
      BE.CNT_RFC_DIST_X_EMAIL AS base_cnt_rfc_dist_x_email_gt1,
      BC.CNT_RFC_DIST_X_CEL AS base_cnt_rfc_dist_x_cel_gt1,
      M.MATCH_INV_CNT_RFC_DIST_X_EMAIL_GT1 AS match_inv_cnt_rfc_dist_x_email_gt1,
      M.MATCH_INV_CNT_RFC_DIST_X_CEL_GT1 AS match_inv_cnt_rfc_dist_x_cel_gt1,
      M.MATCH_INV_LOG AS match_inv_log
    )) AS INVESTIGACION_METRICAS_JSON,

    -- Dominio BFS Integrado para el Agente
    IFNULL(B.BFS_TOTAL_CTAS_REL, 0) AS BFS_TOTAL_CTAS_REL,
    IFNULL(B.BFS_TOTAL_POCKET_REL, 0) AS BFS_TOTAL_POCKET_REL,
    COALESCE(B.BFS_RESUMEN_RIESGO_RED, 'SIN_VINCULOS') AS BFS_RESUMEN_RIESGO_RED,
    PARSE_JSON(B.BFS_NETWORK_GRAPH_JSON) AS BFS_NETWORK_GRAPH_JSON

  FROM UNIV_INI AS U
  INNER JOIN BIO_TRJ_EVAL AS T
    ON T.ID_ROW = CONCAT(CAST(U.CTA_CVE AS STRING), '|', CAST(U.TRJ_NUM AS STRING))
  LEFT JOIN BIO_CTA AS C
    ON C.CTA_CVE = U.CTA_CVE
  LEFT JOIN PRTNCIA_ALL AS P
    ON U.TRJ_NUM = P.TRJ_NUM
  LEFT JOIN MATCH_INV_METRICS AS M
    ON M.BASE_CTA_CVE = U.CTA_CVE
  LEFT JOIN BFS_FINAL_METRICS AS B
    ON B.ROOT_CTA = U.CTA_CVE
  LEFT JOIN CLIE_FTES_ALL AS CF
    ON CF.CTA_CVE = U.CTA_CVE
  LEFT JOIN (
    SELECT EMAIL_CLEAN, CNT_RFC_DIST_X_EMAIL 
    FROM (
      SELECT NULLIF(UPPER(TRIM(CTE_EMA)), '') AS EMAIL_CLEAN, COUNT(DISTINCT IF(REGEXP_CONTAINS(TRIM(IFNULL(CTE_CVE_RFC, '')), r'^0+'), NULL, SUBSTR(TRIM(CTE_CVE_RFC), 1, 13))) AS CNT_RFC_DIST_X_EMAIL
      FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CLIE_FTES_VPL`
      GROUP BY EMAIL_CLEAN HAVING COUNT(DISTINCT IF(REGEXP_CONTAINS(TRIM(IFNULL(CTE_CVE_RFC, '')), r'^0+'), NULL, SUBSTR(TRIM(CTE_CVE_RFC), 1, 13))) > 1
    )
  ) AS BE ON NULLIF(UPPER(TRIM(CF.EMAIL)), '') = BE.EMAIL_CLEAN
  LEFT JOIN (
    SELECT CEL_CLEAN, CNT_RFC_DIST_X_CEL
    FROM (
      SELECT SAFE_CAST(SUBSTR(ZEROS_TO_NULL(CAST(CTE_CEL AS STRING)), -10) AS NUMERIC) AS CEL_CLEAN, COUNT(DISTINCT IF(REGEXP_CONTAINS(TRIM(IFNULL(CTE_CVE_RFC, '')), r'^0+'), NULL, SUBSTR(TRIM(CTE_CVE_RFC), 1, 13))) AS CNT_RFC_DIST_X_CEL
      FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CLIE_FTES_VPL`
      GROUP BY CEL_CLEAN HAVING COUNT(DISTINCT IF(REGEXP_CONTAINS(TRIM(IFNULL(CTE_CVE_RFC, '')), r'^0+'), NULL, SUBSTR(TRIM(CTE_CVE_RFC), 1, 13))) > 1
    )
  ) AS BC ON CF.CEL = BC.CEL_CLEAN
  WHERE FLG_EMBO = 1
);


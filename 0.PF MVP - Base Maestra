SELECT
  TRJ_NUM,
  USR_VPL_R05,
  USR_VPL_CREA,
  FCH_GENERACION,
  HRA_GENERACION,
  TRJ_EDO_CVE,
  BLQ_TRJ_CVE,
  RAZON_BLQ_TRJ_CVE,
  FLG_EMBO,

  MATCH_BIO_STT,
  FLG_BIO_REALIZADO,
  TRJ_BIO_REALIZADO_LOG,
  CTA_ENR_EXISTE,
  CTA_ENR_LOG,

  FLG_PRTNCIA_MATCH,
  PRTNCIA_LOG,

  CLIE_FTES_JSON,
  SDO_CTA_MES_JSON,
  SOLICITUDES_ORIGEN_JSON,
  INVESTIGACION_METRICAS_JSON,

  -- Salidas del Motor de Grafo BFS
  BFS_TOTAL_CTAS_REL,
  BFS_TOTAL_POCKET_REL,
  BFS_RESUMEN_RIESGO_RED,
  BFS_NETWORK_GRAPH_JSON

FROM RESULT_FINAL
ORDER BY FCH_GENERACION, TRJ_NUM;


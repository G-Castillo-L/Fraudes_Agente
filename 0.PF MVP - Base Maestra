-- 7. MÓDULO CAMBIO DE DATOS DE CONTACTO Y RIESGO GEOGRÁFICO
-- ============================================================
CREATE TEMP TABLE TDA_INF AS (
  SELECT DISTINCT
    SAFE_CAST(TDA_CVE AS NUMERIC) AS TDA_CVE,
    TDA_EDO_CVE
  FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_TDA`
);

CREATE TEMP TABLE DAT_CHG AS (
  SELECT
    SAFE_CAST(MANT.CTE_CVE AS NUMERIC) AS CTA_CVE,
    MANT.CDE_OCC AS MANT_CDO,
    MANT.FCH AS MANT_FCH,
    MANT.HRA AS MANT_HRA,
    TRIM(MANT.DES) AS MANT_DES,
    NULLIF(TRIM(MANT.DAT_A), "") AS DAT_A,
    NULLIF(TRIM(MANT.DAT_N), "") AS DAT_N,
    TRIM(MANT.USR) AS VPL_USR
  FROM `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_R09` AS MANT
  INNER JOIN (SELECT DISTINCT CTA_CVE FROM UNIV_INI) AS E
    ON E.CTA_CVE = SAFE_CAST(MANT.CTE_CVE AS NUMERIC)
  WHERE TRIM(MANT.DES) IN ('OWNER EMAIL', 'OWNER MOBILE PHONE')
    AND MANT.FCH >= DATE_SUB(FE_INI, INTERVAL 30 DAY)
);

CREATE TEMP TABLE EMP_CAT AS (
  WITH AUX AS (
    SELECT
      USR,
      CVE_EMP,
      ID_USER AS ID_VPL
    FROM `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VDIM_PREVFRAU_USR_VPL_HIST`
    QUALIFY ROW_NUMBER() OVER(PARTITION BY USR ORDER BY FCH_BAJ ASC, FCH_CARGA DESC) = 1
  )
  SELECT
    AUX.*,
    V.TDA_CVE
  FROM AUX
  LEFT JOIN (
    SELECT
      VND_CVE AS CVE_EMP,
      SAFE_CAST(TDA_CVE AS NUMERIC) AS TDA_CVE
    FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_VND` AS A
    INNER JOIN (SELECT DISTINCT CVE_EMP FROM AUX) AS B
      ON A.VND_CVE = B.CVE_EMP
    QUALIFY ROW_NUMBER() OVER(PARTITION BY VND_CVE ORDER BY FCH_CARGA DESC) = 1
  ) AS V
  USING (CVE_EMP)
);

CREATE TEMP TABLE RIESGO_CAMBIO_DATOS AS (
  SELECT
    CHG.CTA_CVE,
    CHG.MANT_CDO,
    CHG.MANT_FCH,
    CHG.MANT_HRA,
    CHG.MANT_DES,
    CHG.DAT_A,
    CHG.DAT_N,
    CHG.VPL_USR AS USR_CAMBIO, 
    EC.CVE_EMP,
    EC.ID_VPL,
    EC.TDA_CVE AS TDA_CVE_CAMB,
    CTA.TDA_APE,
    TI_A.TDA_EDO_CVE AS TDA_EDO_APE,
    TI_B.TDA_EDO_CVE AS TDA_EDO_CAMB,
    CASE
      WHEN CTA.TDA_APE IS NULL OR EC.TDA_CVE IS NULL THEN 'NO_DETERMINABLE'
      WHEN SAFE_CAST(CTA.TDA_APE AS NUMERIC) != EC.TDA_CVE THEN 'DIF_TDA'
      ELSE 'MIS_TDA'
    END AS FLG_TDA,
    CASE
      WHEN TI_A.TDA_EDO_CVE IS NULL OR TI_B.TDA_EDO_CVE IS NULL THEN 'NO_DETERMINABLE'
      WHEN TRIM(TI_A.TDA_EDO_CVE) != TRIM(TI_B.TDA_EDO_CVE) THEN 'DIF_EDO'
      ELSE 'MISM_EDO'
    END AS FLG_EDO
  FROM DAT_CHG AS CHG
  LEFT JOIN (
    SELECT DISTINCT CTA_CVE, TDA_APE
    FROM SDO_CTA_ALL
  ) AS CTA
    ON CHG.CTA_CVE = CTA.CTA_CVE
  LEFT JOIN EMP_CAT AS EC
    ON CHG.VPL_USR = EC.USR
  LEFT JOIN TDA_INF AS TI_A
    ON TI_A.TDA_CVE = SAFE_CAST(CTA.TDA_APE AS NUMERIC)
  LEFT JOIN TDA_INF AS TI_B
    ON TI_B.TDA_CVE = EC.TDA_CVE
  QUALIFY ROW_NUMBER() OVER(PARTITION BY CHG.CTA_CVE, CHG.MANT_CDO, CHG.MANT_FCH, CHG.MANT_HRA, CHG.MANT_DES, CHG.DAT_A, CHG.DAT_N ORDER BY CVE_EMP DESC) = 1
);

CREATE TEMP TABLE AGG_CAMBIOS_OWNER AS (
  SELECT
    U.CTA_CVE,
    U.TRJ_NUM,
    COUNT(R.CTA_CVE) > 0 AS FLG_CAMBIO_DATOS_CONTACTO,
    COUNTIF(R.FLG_EDO = 'DIF_EDO') > 0 AS FLG_CAMBIO_DATOS_DIF_ESTADO,
    COUNTIF(R.FLG_TDA = 'DIF_TDA') > 0 AS FLG_CAMBIO_DATOS_DIF_TIENDA,
    COUNT(R.CTA_CVE) AS CNT_CAMBIOS_DATOS,
    TO_JSON_STRING(STRUCT(
      COUNT(R.CTA_CVE) > 0 AS hubo_cambio_contacto_30d,
      COUNT(R.CTA_CVE) AS total_mantenimientos,
      COUNTIF(R.FLG_EDO = 'DIF_EDO') AS total_cambios_distinto_estado,
      COUNTIF(R.FLG_TDA = 'DIF_TDA') AS total_cambios_distinta_tienda,
      ARRAY_AGG(
        IF(R.CTA_CVE IS NOT NULL, STRUCT(
          NULLIF(R.MANT_DES, "") AS tipo_campo_modificado,
          NULLIF(R.DAT_A, "") AS valor_anterior,
          NULLIF(R.DAT_N, "") AS valor_nuevo,
          R.MANT_FCH AS fecha_modificacion,
          R.MANT_HRA AS hora_modificacion,
          NULLIF(R.USR_CAMBIO, "") AS usuario_modifico,
          R.CVE_EMP AS num_empleado,
          R.TDA_CVE_CAMB AS tienda_empleado,
          R.TDA_APE AS tienda_apertura_cuenta,
          NULLIF(R.FLG_TDA, "") AS riesgo_tienda,
          NULLIF(R.FLG_EDO, "") AS riesgo_estado
        ), NULL) IGNORE NULLS ORDER BY R.MANT_FCH DESC, R.MANT_HRA DESC
      ) AS detalle_cambios
    )) AS CAMBIOS_DATOS_LOG_JSON
  FROM UNIV_INI AS U
  LEFT JOIN RIESGO_CAMBIO_DATOS AS R
    ON R.CTA_CVE = U.CTA_CVE
   AND R.MANT_FCH BETWEEN DATE_SUB(U.FCH_GENERACION, INTERVAL 30 DAY) AND DATE_ADD(U.FCH_GENERACION, INTERVAL 7 DAY)
  GROUP BY U.CTA_CVE, U.TRJ_NUM
);


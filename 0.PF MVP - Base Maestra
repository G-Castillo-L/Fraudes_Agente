-- 8. MOTOR BFS DECLARATIVO A 2 PASOS (CON TABLAS STAGING)
-- ============================================================
CREATE TEMP TABLE BFS_SEEDS_LVL0 AS (
  SELECT DISTINCT
    K.CTA_CVE AS ROOT_CTA,
    K.SRC AS ROOT_SRC,
    K.K_TYPE,
    K.K_FIELD,
    K.K_VAL,
    K.NOMBRE AS ROOT_NOMBRE,
    K.APE_PAT AS ROOT_APE_PAT,
    K.CDP_CVE AS ROOT_CDP,
    K.ES_SUPERNODO
  FROM `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CONTACT_KEYS` AS K
  INNER JOIN (SELECT DISTINCT CTA_CVE FROM UNIV_INI) AS U 
    ON K.CTA_CVE = U.CTA_CVE
  WHERE K.CTA_CVE > 0
);

CREATE TEMP TABLE BFS_HOP1_CTAS AS (
  SELECT
    ROOT_CTA,
    1 AS DEPTH,
    SRC_ORIGEN,
    SRC_DESTINO,
    CAMPO_CONEXION_ORIGEN,
    CAMPO_CONEXION_DESTINO,
    VALOR_CONEXION,
    CTA_DESTINO,
    NOMBRE_DESTINO,
    APE_PAT_DESTINO,
    CDP_DESTINO,
    ES_MISMO_APELLIDO,
    ES_MISMO_CP,
    IF(
      CTA_DESTINO < 0,
      CONCAT('[SEED CTA=', CAST(ROOT_CTA AS STRING), ' | ', CAMPO_CONEXION_ORIGEN, '=', VALOR_CONEXION, '] -> [HOP 1 APIA (SOLICITUD=', CAST(ABS(CTA_DESTINO) AS STRING), ') | ', CAMPO_CONEXION_DESTINO, ']'),
      CONCAT('[SEED CTA=', CAST(ROOT_CTA AS STRING), ' | ', CAMPO_CONEXION_ORIGEN, '=', VALOR_CONEXION, '] -> [HOP 1 ', SRC_DESTINO, '.', CAMPO_CONEXION_DESTINO, ' | CTA=', CAST(CTA_DESTINO AS STRING), ']')
    ) AS TRACE_PATH
  FROM (
    SELECT
      S.ROOT_CTA,
      S.ROOT_SRC AS SRC_ORIGEN,
      K.SRC AS SRC_DESTINO,
      S.K_FIELD AS CAMPO_CONEXION_ORIGEN,
      K.K_FIELD AS CAMPO_CONEXION_DESTINO,
      S.K_VAL AS VALOR_CONEXION,
      K.CTA_CVE AS CTA_DESTINO,
      K.NOMBRE AS NOMBRE_DESTINO,
      K.APE_PAT AS APE_PAT_DESTINO,
      K.CDP_CVE AS CDP_DESTINO,
      IF(S.ROOT_APE_PAT != '' AND K.APE_PAT != '' AND S.ROOT_APE_PAT = K.APE_PAT, TRUE, FALSE) AS ES_MISMO_APELLIDO,
      IF(S.ROOT_CDP != '' AND K.CDP_CVE != '' AND S.ROOT_CDP = K.CDP_CVE, TRUE, FALSE) AS ES_MISMO_CP,
      ROW_NUMBER() OVER(
        PARTITION BY S.ROOT_CTA, K.CTA_CVE 
        ORDER BY IF(S.ROOT_APE_PAT = K.APE_PAT, 1, 2), K.DEGREE_CNT ASC
      ) AS RN_CTA,
      ROW_NUMBER() OVER(
        PARTITION BY S.ROOT_CTA 
        ORDER BY IF(S.ROOT_APE_PAT = K.APE_PAT, 1, 2), K.DEGREE_CNT ASC
      ) AS RN_LIMIT_PER_ROOT
    FROM BFS_SEEDS_LVL0 AS S
    JOIN `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CONTACT_KEYS` AS K
      ON S.K_TYPE = K.K_TYPE
     AND S.K_VAL = K.K_VAL
     AND S.ROOT_CTA != K.CTA_CVE
    WHERE S.ES_SUPERNODO = FALSE
      AND K.ES_SUPERNODO = FALSE
      AND K.CTA_CVE != 0
  )
  WHERE RN_CTA = 1 AND RN_LIMIT_PER_ROOT <= 25
);

CREATE TEMP TABLE BFS_HOP1_POCKET AS (
  SELECT DISTINCT
    S.ROOT_CTA,
    1 AS DEPTH,
    S.ROOT_SRC AS SRC_ORIGEN,
    'CUSTOMERS' AS SRC_DESTINO,
    S.K_FIELD AS CAMPO_CONEXION_ORIGEN,
    C.K_FIELD AS CAMPO_CONEXION_DESTINO,
    S.K_VAL AS VALOR_CONEXION,
    C.ID_CUSTOMERS,
    C.MON_DIG,
    C.FCH_ALTA AS FCH_ALTA_POCKET,
    C.NOMBRE AS NOMBRE_DESTINO,
    IF(S.ROOT_APE_PAT != '' AND C.APE_PAT != '' AND S.ROOT_APE_PAT = C.APE_PAT, TRUE, FALSE) AS ES_MISMO_APELLIDO,
    CONCAT('[SEED CTA=', CAST(S.ROOT_CTA AS STRING), ' | ', S.K_FIELD, '=', S.K_VAL, '] -> [HOP 1 CUSTOMER.', C.K_FIELD, ' | ID=', C.ID_CUSTOMERS, ']') AS TRACE_PATH
  FROM BFS_SEEDS_LVL0 AS S
  JOIN `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CUSTOMER_KEYS` AS C
    ON S.K_TYPE = C.K_TYPE
   AND S.K_VAL = C.K_VAL
  WHERE S.ES_SUPERNODO = FALSE
  QUALIFY ROW_NUMBER() OVER(PARTITION BY S.ROOT_CTA, C.ID_CUSTOMERS ORDER BY C.FCH_ALTA DESC) = 1
);

CREATE TEMP TABLE BFS_SEEDS_LVL1 AS (
  SELECT DISTINCT
    H.ROOT_CTA,
    H.CTA_DESTINO AS HOP1_CTA,
    K.SRC AS HOP1_SRC,
    K.K_TYPE,
    K.K_FIELD,
    K.K_VAL,
    K.NOMBRE,
    K.APE_PAT,
    K.CDP_CVE,
    H.TRACE_PATH
  FROM BFS_HOP1_CTAS AS H
  JOIN `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CONTACT_KEYS` AS K 
    ON H.CTA_DESTINO = K.CTA_CVE
  WHERE K.ES_SUPERNODO = FALSE
    AND H.CTA_DESTINO != 0
    AND K.CTA_CVE != 0
);

CREATE TEMP TABLE BFS_KEYS_TARGET_HOP2 AS (
  SELECT K.*
  FROM `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CONTACT_KEYS` AS K
  WHERE K.ES_SUPERNODO = FALSE
    AND K.CTA_CVE != 0
    AND EXISTS (
      SELECT 1 FROM BFS_SEEDS_LVL1 AS S
      WHERE S.K_TYPE = K.K_TYPE AND S.K_VAL = K.K_VAL
    )
);

CREATE TEMP TABLE BFS_HOP2_CTAS AS (
  SELECT
    ROOT_CTA,
    2 AS DEPTH,
    SRC_ORIGEN,
    SRC_DESTINO,
    CAMPO_CONEXION_ORIGEN,
    CAMPO_CONEXION_DESTINO,
    VALOR_CONEXION,
    CTA_DESTINO,
    NOMBRE_DESTINO,
    APE_PAT_DESTINO,
    CDP_DESTINO,
    ES_MISMO_APELLIDO,
    ES_MISMO_CP,
    IF(
      CTA_DESTINO < 0,
      CONCAT(TRACE_PATH, ' -> [HOP 2 APIA (SOLICITUD=', CAST(ABS(CTA_DESTINO) AS STRING), ') | ', CAMPO_CONEXION_DESTINO, ']'),
      CONCAT(TRACE_PATH, ' -> [HOP 2 ', SRC_DESTINO, '.', CAMPO_CONEXION_DESTINO, ' | CTA=', CAST(CTA_DESTINO AS STRING), ']')
    ) AS TRACE_PATH
  FROM (
    SELECT
      S.ROOT_CTA,
      S.HOP1_SRC AS SRC_ORIGEN,
      K.SRC AS SRC_DESTINO,
      S.K_FIELD AS CAMPO_CONEXION_ORIGEN,
      K.K_FIELD AS CAMPO_CONEXION_DESTINO,
      S.K_VAL AS VALOR_CONEXION,
      K.CTA_CVE AS CTA_DESTINO,
      K.NOMBRE AS NOMBRE_DESTINO,
      K.APE_PAT AS APE_PAT_DESTINO,
      K.CDP_CVE AS CDP_DESTINO,
      IF(S.APE_PAT != '' AND K.APE_PAT != '' AND S.APE_PAT = K.APE_PAT, TRUE, FALSE) AS ES_MISMO_APELLIDO,
      IF(S.CDP_CVE != '' AND K.CDP_CVE != '' AND S.CDP_CVE = K.CDP_CVE, TRUE, FALSE) AS ES_MISMO_CP,
      S.TRACE_PATH,
      ROW_NUMBER() OVER(
        PARTITION BY S.ROOT_CTA, K.CTA_CVE 
        ORDER BY IF(S.APE_PAT = K.APE_PAT, 1, 2), K.DEGREE_CNT ASC
      ) AS RN_CTA,
      ROW_NUMBER() OVER(
        PARTITION BY S.ROOT_CTA 
        ORDER BY IF(S.APE_PAT = K.APE_PAT, 1, 2), K.DEGREE_CNT ASC
      ) AS RN_LIMIT_PER_ROOT
    FROM BFS_SEEDS_LVL1 AS S
    JOIN BFS_KEYS_TARGET_HOP2 AS K
      ON S.K_TYPE = K.K_TYPE
     AND S.K_VAL = K.K_VAL
     AND S.ROOT_CTA != K.CTA_CVE
     AND S.HOP1_CTA != K.CTA_CVE
    WHERE K.CTA_CVE != 0
  )
  WHERE RN_CTA = 1 AND RN_LIMIT_PER_ROOT <= 35
);

CREATE TEMP TABLE BFS_HOP2_POCKET AS (
  SELECT DISTINCT
    S.ROOT_CTA,
    2 AS DEPTH,
    S.HOP1_SRC AS SRC_ORIGEN,
    'CUSTOMERS' AS SRC_DESTINO,
    S.K_FIELD AS CAMPO_CONEXION_ORIGEN,
    C.K_FIELD AS CAMPO_CONEXION_DESTINO,
    S.K_VAL AS VALOR_CONEXION,
    C.ID_CUSTOMERS,
    C.MON_DIG,
    C.FCH_ALTA AS FCH_ALTA_POCKET,
    C.NOMBRE AS NOMBRE_DESTINO,
    IF(S.APE_PAT != '' AND C.APE_PAT != '' AND S.APE_PAT = C.APE_PAT, TRUE, FALSE) AS ES_MISMO_APELLIDO,
    CONCAT(S.TRACE_PATH, ' -> [HOP 2 CUSTOMER.', C.K_FIELD, ' | ID=', C.ID_CUSTOMERS, ']') AS TRACE_PATH
  FROM BFS_SEEDS_LVL1 AS S
  JOIN `crp-pro-dominio-negfin.mus_pro_prevfrau_wrk_tbls.STG_BFS_CUSTOMER_KEYS` AS C
    ON S.K_TYPE = C.K_TYPE
   AND S.K_VAL = C.K_VAL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY S.ROOT_CTA, C.ID_CUSTOMERS ORDER BY C.FCH_ALTA DESC) = 1
);

CREATE TEMP TABLE BFS_CONSOLIDATED_NODES AS (
  WITH RAW_UNION AS (
    SELECT ROOT_CTA, DEPTH, SRC_ORIGEN, SRC_DESTINO, CAMPO_CONEXION_ORIGEN, CAMPO_CONEXION_DESTINO, VALOR_CONEXION, CTA_DESTINO, NULL AS ID_CUSTOMERS, NULL AS MON_DIG, NOMBRE_DESTINO, ES_MISMO_APELLIDO, ES_MISMO_CP, TRACE_PATH
    FROM BFS_HOP1_CTAS
    UNION ALL
    SELECT ROOT_CTA, DEPTH, SRC_ORIGEN, SRC_DESTINO, CAMPO_CONEXION_ORIGEN, CAMPO_CONEXION_DESTINO, VALOR_CONEXION, NULL AS CTA_DESTINO, ID_CUSTOMERS, MON_DIG, NOMBRE_DESTINO, ES_MISMO_APELLIDO, FALSE AS ES_MISMO_CP, TRACE_PATH
    FROM BFS_HOP1_POCKET
    UNION ALL
    SELECT ROOT_CTA, DEPTH, SRC_ORIGEN, SRC_DESTINO, CAMPO_CONEXION_ORIGEN, CAMPO_CONEXION_DESTINO, VALOR_CONEXION, CTA_DESTINO, NULL AS ID_CUSTOMERS, NULL AS MON_DIG, NOMBRE_DESTINO, ES_MISMO_APELLIDO, ES_MISMO_CP, TRACE_PATH
    FROM BFS_HOP2_CTAS
    UNION ALL
    SELECT ROOT_CTA, DEPTH, SRC_ORIGEN, SRC_DESTINO, CAMPO_CONEXION_ORIGEN, CAMPO_CONEXION_DESTINO, VALOR_CONEXION, NULL AS CTA_DESTINO, ID_CUSTOMERS, MON_DIG, NOMBRE_DESTINO, ES_MISMO_APELLIDO, FALSE AS ES_MISMO_CP, TRACE_PATH
    FROM BFS_HOP2_POCKET
  )
  SELECT *
  FROM RAW_UNION
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY ROOT_CTA, COALESCE(IF(CTA_DESTINO > 0, CAST(CTA_DESTINO AS STRING), CONCAT('SOLIC_', CAST(ABS(CTA_DESTINO) AS STRING))), CONCAT('CUST_', ID_CUSTOMERS))
    ORDER BY DEPTH ASC, LENGTH(TRACE_PATH) ASC
  ) = 1
);

CREATE TEMP TABLE BFS_FINAL_METRICS AS (
  WITH STATS_PER_ROOT AS (
    SELECT
      ROOT_CTA,
      COUNTIF(CTA_DESTINO > 0) AS TOTAL_CTAS_REL,
      COUNTIF(CTA_DESTINO < 0) AS TOTAL_SOLICITUDES_REL,
      COUNTIF(ID_CUSTOMERS IS NOT NULL) AS TOTAL_POCKET_REL,
      COUNTIF(CTA_DESTINO > 0 AND ES_MISMO_APELLIDO = FALSE AND ES_MISMO_CP = FALSE) AS CNT_SIN_PARENTESCO,
      COUNTIF(CTA_DESTINO > 0 AND ES_MISMO_APELLIDO = TRUE) AS CNT_CON_PARENTESCO,
      MAX(DEPTH) AS MAX_DEPTH
    FROM BFS_CONSOLIDATED_NODES
    GROUP BY ROOT_CTA
  ),
  AGG_JSON_PER_ROOT AS (
    SELECT
      ROOT_CTA,
      ARRAY_AGG(
        STRUCT(
          DEPTH AS salto,
          NULLIF(SRC_ORIGEN, "") AS fuente_origen,
          NULLIF(SRC_DESTINO, "") AS fuente_destino,
          NULLIF(CAMPO_CONEXION_ORIGEN, "") AS campo_origen,
          NULLIF(CAMPO_CONEXION_DESTINO, "") AS campo_destino,
          NULLIF(VALOR_CONEXION, "") AS dato_contacto_compartido,
          IF(CTA_DESTINO > 0, CTA_DESTINO, NULL) AS cuenta_credito_destino,
          IF(CTA_DESTINO < 0, ABS(CTA_DESTINO), NULL) AS solicitud_origen_destino,
          NULLIF(ID_CUSTOMERS, "") AS id_customer_pocket,
          NULLIF(MON_DIG, "") AS monedero_digital_pocket,
          NULLIF(NOMBRE_DESTINO, "") AS titular_destino,
          ES_MISMO_APELLIDO AS coincide_apellido,
          ES_MISMO_CP AS coincide_codigo_postal,
          NULLIF(TRACE_PATH, "") AS traza_recorrido
        )
        ORDER BY DEPTH ASC, SRC_DESTINO ASC
        LIMIT 40
      ) AS TRAZAS_ARRAY
    FROM BFS_CONSOLIDATED_NODES
    GROUP BY ROOT_CTA
  )
  SELECT
    S.ROOT_CTA,
    S.TOTAL_CTAS_REL AS BFS_TOTAL_CTAS_REL,
    S.TOTAL_POCKET_REL AS BFS_TOTAL_POCKET_REL,
    S.MAX_DEPTH AS BFS_MAX_DEPTH,
    CASE
      WHEN S.TOTAL_CTAS_REL = 0 AND S.TOTAL_SOLICITUDES_REL = 0 AND S.TOTAL_POCKET_REL = 0 THEN 'SIN_VINCULOS'
      WHEN S.CNT_SIN_PARENTESCO >= 2 THEN 'PATRON_ANILLO_RIESGO'
      WHEN S.CNT_CON_PARENTESCO > 0 THEN 'POSIBLE_VINCULO_FAMILIAR'
      ELSE 'VINCULO_DIRECTO_DESCONOCIDO'
    END AS BFS_RESUMEN_RIESGO_RED,
    TO_JSON_STRING(STRUCT(
      S.TOTAL_CTAS_REL AS total_cuentas_credito_relacionadas,
      S.TOTAL_SOLICITUDES_REL AS total_solicitudes_origen_relacionadas,
      S.TOTAL_POCKET_REL AS total_cuentas_pocket_relacionadas,
      S.MAX_DEPTH AS profundidad_maxima_alcanzada,
      J.TRAZAS_ARRAY AS trazas_red_conexiones
    )) AS BFS_NETWORK_GRAPH_JSON
  FROM STATS_PER_ROOT AS S
  LEFT JOIN AGG_JSON_PER_ROOT AS J
    ON S.ROOT_CTA = J.ROOT_CTA
);

-- ============================================================
-- 9. MOTOR DE TRANSACCIONALIDAD B24 / OFF-US
-- ============================================================
CREATE TEMP TABLE TXN_B24_CLASIF AS (
  WITH CTAS_UNIV AS (
    SELECT DISTINCT 
      CTA_CVE, 
      TRJ_NUM
    FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CTA_TRJ`
    WHERE CTA_CVE IN (SELECT DISTINCT CTA_CVE FROM UNIV_INI)
  ),
  AUX AS (
    SELECT
      B.CTA_CVE,
      A.NUMERO_TARJETA,
      A.FECHA_TRANS,
      A.HORA_TRANS,
      SAFE_CAST(A.ID_COMER AS NUMERIC) AS ID_COMER,
      A.NOMBRE_DE_TERMINAL,
      A.MONTO AS IMPORTE,
      CASE
        WHEN A.ENTRY_MODE IN ('010','011','012') THEN 'INTERNET'
        WHEN A.ENTRY_MODE IN ('020','021','022','900','901','902') THEN 'BANDA'
        WHEN A.ENTRY_MODE IN ('050','051','052') THEN 'CHIP'
        WHEN A.ENTRY_MODE IN ('100','101','102') THEN 'COF'
        WHEN A.ENTRY_MODE IN ('070','071','072') THEN 'CONTACTLESS'
        WHEN A.ENTRY_MODE = '910' THEN 'EWALLET'
        WHEN A.ENTRY_MODE IN ('800','801','802') THEN 'FALL'
        ELSE 'DESC'
      END AS ENTRY_MODE,
      CASE 
        WHEN A.CODIGO_RESPUESTA IN ('000','001','002','003','004','005','006','007','008','009') THEN 'APROBADA'
      END AS RESPUESTA,
      CASE
        WHEN A.TIPO_TRANSAC IN ('10','13') THEN 'COMPRA'
        WHEN A.TIPO_TRANSAC IN ('16') THEN 'VALIDACION'
        WHEN A.TIPO_TRANSAC IN ('21') THEN 'PAGO'
      END AS TIP_TXN,
      CASE 
        WHEN A.KQ2_ID_MEDIO_ACCESO = '00' THEN 'SIN CANAL IDENTIFICADO'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '01' THEN 'CANAL MANUAL POR VOZ'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '02' THEN 'CARGO RECURRENTE'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '03' THEN 'TERMINAL PUNTO DE VENTA PROPIA'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '04' THEN 'TRANSACCION PROCESADA ENTRE REDES'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '05' THEN 'AUTORIZACION TELEFONICA'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '06' THEN 'OPERACION EN VENTANILLA BANCARIA'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '07' THEN 'CAJEROS PERMANENTES'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '08' THEN 'VENTA POR TELEFONO'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '09' THEN 'ECOMMERCE'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '10' THEN 'ADQUIRIENTE DOMESTICO'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '11' THEN 'ADQUIRIENTE INTERNACIONAL'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '12' THEN 'ATM DE OTRA RED NACIONAL'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '13' THEN 'ATM EN EL EXTRANJERO'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '14' THEN 'SERVIDORES MULTICAJA'
        WHEN A.KQ2_ID_MEDIO_ACCESO = '24' THEN 'TELEPEAJE - TAG'
      END AS TIPO_TERMINAL,
      CASE
        WHEN A.ENTRY_MODE NOT IN ('010','011','012') OR A.KQ2_ID_MEDIO_ACCESO = '02' THEN 'NO APLICA'
        WHEN A.KC0_CVV2 = '0' THEN 'TXN SIN CVV'
        WHEN A.KC0_CVV2 IN ('1','2') THEN 'TXN CON CVV'
      END AS PRESENCIA_CVV,
      CASE 
        WHEN A.KC4_ID_IND = '0' THEN 'DESCONOCIDO'
        WHEN A.KC4_ID_IND = '1' THEN 'FIRMA'
        WHEN A.KC4_ID_IND = '2' THEN 'PIN'
        WHEN A.KC4_ID_IND = '3' THEN 'TERMINAL NO ATENDIDA'
        WHEN A.KC4_ID_IND = '4' THEN 'ORDEN CORREO TELEFONO'
        WHEN A.KC4_ID_IND = '5' THEN 'QPS'
        WHEN A.KC4_ID_IND = '9' THEN 'DESCONOCIDO'
        WHEN A.ENTRY_MODE NOT IN ('050','051','052') THEN 'NO APLICA'
      END AS MEDIO_DE_ACCESO,
      CASE 
        WHEN A.KC0_IND_ECOM = '5' THEN 'COMERCIO SEGURO'
        WHEN A.KC0_IND_ECOM = '7' THEN 'COMERCIO NO SEGURO'
        WHEN A.ENTRY_MODE NOT IN ('010','011','012') OR A.KQ2_ID_MEDIO_ACCESO = '02' THEN 'NO APLICA'
      END AS COMERCIO_SEGURO,
      A.T_CNTRY,
      A.SIC_CDE AS MCC,
      D.MCC_DES,
      CASE
        WHEN D.MCC_FLG = 0 THEN 'VIATICOS'
        WHEN D.MCC_FLG IN (1,2) THEN 'TRANSACCIÓN HABITUAL'
        WHEN D.MCC_FLG = 3 THEN 'ALTO RIESGO'
      END AS MCC_FLG,
      A.KC4_METODO_IDENT_TH,
      CASE
        WHEN A.KC0_IND_ECOM <> '5' OR A.KQ2_ID_MEDIO_ACCESO = '02' THEN 'NO APLICA'
        WHEN C.AUTHENTICATION_STATUS = 'Y' AND C.AUTHENTICATION_TYPE = 'OTP - SMS' THEN 'Autenticado por SMS'
        WHEN C.AUTHENTICATION_STATUS = 'Y' AND C.AUTHENTICATION_TYPE = 'OTP - Email' THEN 'Autenticado por Email'
        WHEN C.AUTHENTICATION_STATUS = 'Y' AND C.AUTHENTICATION_TYPE = 'Challenge Choice' THEN 'Autenticado'
      END AS AUTENTICACION,
      A.TERM_NAME_LOC,
      A.CIUDAD_TERMINAL,
      SAFE_CAST(SUBSTR(REGEXP_REPLACE(A.TERM_ID_TERM, r"\D*", ""), -3) AS NUMERIC) AS TERM
    FROM `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_TRN_TRJ_INT` AS A
    INNER JOIN CTAS_UNIV AS B
      ON SAFE_CAST(A.NUMERO_TARJETA AS NUMERIC) = B.TRJ_NUM
    LEFT JOIN `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_VCASREPORTE_2_0` AS C
      ON A.NUMERO_TARJETA = C.ACCOUNT_NUMBER 
     AND A.FECHA_TRANS = C.PURCHASE_DATE 
     AND A.NOMBRE_DE_TERMINAL = C.MERCHANT_NAME
    LEFT JOIN `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VCIS_PREVFRAU_MCC_CDO` AS D
      ON A.SIC_CDE = D.MCC_CDO
    WHERE A.FECHA_TRANS BETWEEN DATE_SUB(FE_INI, INTERVAL 90 DAY) AND FE_FIN
      AND A.TIPO_TRANSAC IN ('10', '13', '16', '21')
      AND A.FIID_COMER NOT IN ('LIVP', 'B730', 'EWAL', 'SFER')
      AND A.TIPO = '0210'
      AND A.CODIGO_RESPUESTA <= '009'
    QUALIFY ROW_NUMBER() OVER(
      PARTITION BY 
        A.FECHA_TRANS, A.HORA_TRANS, A.TIPO, A.MONTO, A.ID_COMER, A.SIC_CDE, A.CODIGO_RESPUESTA, A.ENTRY_MODE
      ORDER BY 
        CASE WHEN STARTS_WITH(A.FLG_ORIGEN_TRANS, "POS") THEN 0 ELSE 1 END ASC,
        A.FCH_INFO DESC,
        A.ENTRY_T ASC NULLS LAST,
        A.KQ2_ID_MEDIO_ACCESO DESC NULLS LAST, 
        A.KQN_FLAG DESC NULLS LAST, 
        A.KCH_RESP_SRC_RSN_CDE DESC NULLS LAST, 
        A.KRJ_VERSION_3DS DESC NULLS LAST, 
        A.KC0_IND_ECOM DESC NULLS LAST, 
        A.KC0_CVV2 DESC NULLS LAST, 
        A.KC4_NIV_SEG DESC NULLS LAST, 
        A.KC0_RESULTADO_VALIDACION_CAVV DESC NULLS LAST, 
        A.KC4_ID_IND DESC NULLS LAST, 
        A.KFH_ECOMM_3D_SECURE_IND DESC NULLS LAST, 
        A.KFH_CAV_TYP DESC NULLS LAST,
        A.UIDT DESC
    ) = 1
  )
  SELECT 
    *,
    CASE
      WHEN ENTRY_MODE <> 'CHIP' THEN 'No aplica'
      WHEN ENTRY_MODE = 'CHIP' AND MEDIO_DE_ACCESO = 'QPS' THEN 'Transacción QPS'
      WHEN ENTRY_MODE = 'CHIP' AND MEDIO_DE_ACCESO <> 'PIN' AND KC4_METODO_IDENT_TH <> '2' THEN 'Transacción sin NIP'
      WHEN ENTRY_MODE = 'CHIP' AND MEDIO_DE_ACCESO NOT IN ('PIN') THEN 'Transacción sin NIP'
      ELSE 'Transacción con NIP'
    END AS FLAG_TXN_SIN_NIP,
    CASE 
      WHEN EXTRACT(HOUR FROM HORA_TRANS) BETWEEN 0 AND 5 THEN 1 
      ELSE 0 
    END AS FLAG_HORARIO_NOCTURNO,
    CASE 
      WHEN UPPER(T_CNTRY) != 'MX' THEN 1 
      ELSE 0 
    END AS FLAG_PAIS_EXTRANJERO
  FROM AUX
);

CREATE TEMP TABLE AGN_TXN_TRJ AS (
  SELECT
    CTA_CVE,
    SAFE_CAST(NUMERO_TARJETA AS NUMERIC) AS TRJ_NUM,
    TO_JSON_STRING(ARRAY_AGG(
      STRUCT(
        FECHA_TRANS AS fecha_trans,
        HORA_TRANS AS hora_trans,
        TIP_TXN AS tipo_transaccion,
        ID_COMER AS id_comer,
        NOMBRE_DE_TERMINAL AS nombre_terminal,
        IMPORTE AS importe,
        ENTRY_MODE AS entry_mode,
        RESPUESTA AS respuesta,
        TIPO_TERMINAL AS tipo_terminal,
        PRESENCIA_CVV AS presencia_cvv,
        MEDIO_DE_ACCESO AS medio_acceso,
        COMERCIO_SEGURO AS comercio_seguro,
        MCC AS mcc,
        MCC_DES AS mcc_des,
        MCC_FLG AS mcc_flg,
        AUTENTICACION AS autenticacion,
        T_CNTRY AS t_cntry,
        FLAG_TXN_SIN_NIP AS flag_sin_nip,
        FLAG_HORARIO_NOCTURNO AS flag_horario_nocturno,
        FLAG_PAIS_EXTRANJERO AS flag_pais_extranjero
      )
      ORDER BY FECHA_TRANS DESC, HORA_TRANS DESC
    )) AS TXN_OFFUS_B24_TRJ
  FROM TXN_B24_CLASIF
  GROUP BY CTA_CVE, SAFE_CAST(NUMERO_TARJETA AS NUMERIC)
);

CREATE TEMP TABLE AGG_TXN_CTA_TOP10 AS (
  WITH TOP_TXN AS (
    SELECT
      U.CTA_CVE,
      U.TRJ_NUM,
      T.NUMERO_TARJETA AS tarjeta,
      T.FECHA_TRANS AS fecha_trans,
      T.HORA_TRANS AS hora_trans,
      T.TIP_TXN AS tipo_transaccion,
      T.ID_COMER AS id_comer,
      T.NOMBRE_DE_TERMINAL AS nombre_terminal,
      T.IMPORTE AS importe,
      T.ENTRY_MODE AS entry_mode,
      T.RESPUESTA AS respuesta,
      T.TIPO_TERMINAL AS tipo_terminal,
      T.PRESENCIA_CVV AS presencia_cvv,
      T.MEDIO_DE_ACCESO AS medio_acceso,
      T.COMERCIO_SEGURO AS comercio_seguro,
      T.MCC AS mcc,
      T.MCC_DES AS mcc_des,
      T.MCC_FLG AS mcc_flg,
      T.AUTENTICACION AS autenticacion,
      T.T_CNTRY AS t_cntry,
      T.FLAG_TXN_SIN_NIP AS flag_sin_nip,
      T.FLAG_HORARIO_NOCTURNO AS flag_horario_nocturno,
      T.FLAG_PAIS_EXTRANJERO AS flag_pais_extranjero
    FROM UNIV_INI AS U
    INNER JOIN TXN_B24_CLASIF AS T
      ON U.CTA_CVE = T.CTA_CVE
     AND U.TRJ_NUM != SAFE_CAST(T.NUMERO_TARJETA AS NUMERIC)
    QUALIFY ROW_NUMBER() OVER (
      PARTITION BY U.CTA_CVE, U.TRJ_NUM 
      ORDER BY T.FECHA_TRANS DESC, T.HORA_TRANS DESC
    ) <= 10
  )
  SELECT
    CTA_CVE,
    TRJ_NUM,
    TO_JSON_STRING(ARRAY_AGG(
      STRUCT(
        tarjeta,
        fecha_trans,
        hora_trans,
        tipo_transaccion,
        id_comer,
        nombre_terminal,
        importe,
        entry_mode,
        respuesta,
        tipo_terminal,
        presencia_cvv,
        medio_acceso,
        comercio_seguro,
        mcc,
        mcc_des,
        mcc_flg,
        autenticacion,
        t_cntry,
        flag_sin_nip,
        flag_horario_nocturno,
        flag_pais_extranjero
      )
      ORDER BY fecha_trans DESC, hora_trans DESC
    )) AS TXN_OFFUS_B24_CUENTA
  FROM TOP_TXN
  GROUP BY CTA_CVE, TRJ_NUM
);

CREATE TEMP TABLE AGG_TXN_OFFUS_B24 AS (
  SELECT
    U.CTA_CVE,
    U.TRJ_NUM,
    TRJ.TXN_OFFUS_B24_TRJ,
    CTA.TXN_OFFUS_B24_CUENTA
  FROM UNIV_INI AS U
  LEFT JOIN AGN_TXN_TRJ AS TRJ
    ON U.CTA_CVE = TRJ.CTA_CVE
   AND U.TRJ_NUM = TRJ.TRJ_NUM
  LEFT JOIN AGG_TXN_CTA_TOP10 AS CTA
    ON U.CTA_CVE = CTA.CTA_CVE
   AND U.TRJ_NUM = CTA.TRJ_NUM
);

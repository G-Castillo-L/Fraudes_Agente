-- 10. ENSAMBLE FINAL Y CREACIÓN DE TABLA FÍSICA OPTIMIZADA
-- ============================================================
CREATE OR REPLACE TABLE `crp-qas-dominio-negfin.mus_qas_prevfrau_wrk_tbls.VFAC_PREVFRAU_AGENT_EMB_DAILY`
PARTITION BY FCH_GENERACION
CLUSTER BY TDA, USR_VPL_CREA, TRJ_NUM, MATCH_BIO_STT
AS
WITH USR_CAT AS (
  SELECT
    USR,
    ID_USER AS ID_PERF_VPL,
    TDA
  FROM `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VDIM_PREVFRAU_USR_VPL_HIST`
  QUALIFY ROW_NUMBER() OVER(PARTITION BY USR ORDER BY FCH_BAJ ASC, FCH_CARGA DESC) = 1
),
BASE_UNIFICADA AS (
  SELECT
    U.TRJ_NUM,
    U.USR_VPL_CREA,
    UC.ID_PERF_VPL,
    UC.TDA,
    U.FCH_GENERACION,
    U.HRA_GENERACION,
    U.TRJ_EDO_CVE,
    U.BLQ_TRJ_CVE,
    U.RAZON_BLQ_TRJ_CVE,
    
    -- Dominio Biométrico
    T.MATCH_BIO_STT,
    PARSE_JSON(T.TRJ_BIO_REALIZADO_LOG_JSON) AS TRJ_BIO_REALIZADO_LOG,
    PARSE_JSON(T.TRJ_BIO_LOG_JSON) AS TRJ_BIO_LOG,
    C.CTA_ENR_EXISTE_BOOL AS CTA_ENR_EXISTE,
    PARSE_JSON(C.CTA_ENR_LOG_JSON) AS CTA_ENR_LOG,
    
    -- Dominio Pertenencia en Entrega
    IF(IFNULL(P.CTA_CVE, 0) > 0, TRUE, FALSE) AS FLG_PRTNCIA_MATCH,
    TO_JSON_STRING(STRUCT(
      NULLIF(P.CODIGO_ACCION, "") AS codigo_accion,
      P.TDA_ATENCION AS tienda_atencion,
      NULLIF(P.ID_ATENCION, "") AS id_atencion,
      P.FECHA AS fecha,
      P.HORA AS hora,
      P.BYPASS_I AS bypass_aplicado,
      P.AUTENTICADO_I AS autenticado_status,
      P.AUTENTICACION_I AS tipo_autenticacion,
      NULLIF(P.EMAIL, "") AS email_contacto,
      P.CEL AS celular_contacto
    )) AS PRTNCIA_LOG,
    
    -- Dominio OTP Risk
    IFNULL(OTP.FLG_RIESGO_OTP, FALSE) AS FLG_RIESGO_OTP,
    COALESCE(OTP.RIESGO_OTP_TIPO, 'SIN_RIESGO_OTP_DETECTADO') AS RIESGO_OTP_TIPO,
    IFNULL(OTP.OTP_OK_30M, FALSE) AS OTP_OK_30M,
    IFNULL(OTP.OTP_FAIL_90M, FALSE) AS OTP_FAIL_90M,
    IFNULL(OTP.CHG_OWNER_60M, FALSE) AS OTP_CHG_OWNER_60M,
    PARSE_JSON(OTP.OTP_RIESGO_LOG_JSON) AS OTP_RIESGO_LOG,
    
    -- Dominio Cambio de Datos (Mantenimientos R09 / Riesgo Empleado)
    IFNULL(CHG.FLG_CAMBIO_DATOS_CONTACTO, FALSE) AS FLG_CAMBIO_DATOS_CONTACTO,
    IFNULL(CHG.FLG_CAMBIO_DATOS_DIF_ESTADO, FALSE) AS FLG_CAMBIO_DATOS_DIF_ESTADO,
    IFNULL(CHG.FLG_CAMBIO_DATOS_DIF_TIENDA, FALSE) AS FLG_CAMBIO_DATOS_DIF_TIENDA,
    IFNULL(CHG.CNT_CAMBIOS_DATOS, 0) AS CNT_CAMBIOS_DATOS,
    PARSE_JSON(CHG.CAMBIOS_DATOS_LOG_JSON) AS CAMBIOS_DATOS_LOG,
    
    -- Dominio Demográfico, Saldos y Solicitudes
    TO_JSON_STRING(STRUCT(
      U.CTE_CVE_UNICO AS cte_cve_unico,
      U.CTA_CVE AS cta_cve_tarjeta,
      ARRAY(
        SELECT AS STRUCT
          C.CTA_CVE, NULLIF(C.NOMBRE, "") AS NOMBRE, NULLIF(C.CTE_CVE_RFC, "") AS CTE_CVE_RFC, C.TEL, C.CEL, NULLIF(C.EMAIL, "") AS EMAIL, NULLIF(C.DIRECCION, "") AS DIRECCION, NULLIF(C.CDP_CVE, "") AS CDP_CVE, NULLIF(C.SEXO, "") AS SEXO,
          C.FCH_NAC, C.FCH_APERTURA, NULLIF(C.EMPLEO, "") AS EMPLEO, C.TEL_OFI, NULLIF(C.NOM_CONYUGE, "") AS NOM_CONYUGE, NULLIF(C.NOM_REF1, "") AS NOM_REF1, C.TEL_REF1, NULLIF(C.NOM_REF2, "") AS NOM_REF2, C.TEL_REF2
        FROM CLIE_FTES_ALL AS C
        WHERE C.CTE_CVE_UNICO = U.CTE_CVE_UNICO
      ) AS cuentas
    )) AS CLIE_FTES_JSON,
    TO_JSON_STRING(STRUCT(
      U.CTE_CVE_UNICO AS cte_cve_unico,
      ARRAY(
        SELECT AS STRUCT
          S.CTA_CVE, NULLIF(S.CTA_EDO_CVE, "") AS CTA_EDO_CVE, S.CTA_NIV_MOR, S.CTA_IMP_LIM_CRD, S.CTA_SDO_ACT, NULLIF(S.CTA_HIST_PAGOS, "") AS CTA_HIST_PAGOS,
          S.TDA_APE, NULLIF(S.BLOQ1, "") AS BLOQ1, NULLIF(S.BLOQ2, "") AS BLOQ2, S.CTA_DEV, S.CTA_PAG, S.CTA_IMP
        FROM SDO_CTA_ALL AS S
        WHERE S.CTE_CVE_UNICO = U.CTE_CVE_UNICO
      ) AS cuentas
    )) AS SDO_CTA_MES_JSON,
    TO_JSON_STRING(STRUCT(
      U.CTE_CVE_UNICO AS cte_cve_unico,
      ARRAY(
        SELECT AS STRUCT
          SO.CTA_CVE, SO.BR_SOLIC_CVE, SO.FCH_SOL, SO.HRA_SOL, NULLIF(SO.BRAND, "") AS BRAND, NULLIF(SO.CL, "") AS CL, NULLIF(SO.STT_FICO, "") AS STT_FICO,
          NULLIF(SO.STT_SIMP_FICO, "") AS STT_SIMP_FICO, NULLIF(SO.FICO_RFC, "") AS FICO_RFC, NULLIF(SO.APIA_CURP, "") AS APIA_CURP, NULLIF(SO.APIA_RFC, "") AS APIA_RFC, NULLIF(SO.BR_TIPO_3, "") AS BR_TIPO_3, SO.TIP_INF
        FROM SOLICITUDES_ALL AS SO
        WHERE SO.CTE_CVE_UNICO = U.CTE_CVE_UNICO
      ) AS solicitudes
    )) AS SOLICITUDES_ORIGEN_JSON,
    
    -- Dominio Multicuenta / Investigaciones
    TO_JSON_STRING(STRUCT(
      M.CNT_CTA_INV AS cnt_cta_inv,
      BE.CNT_RFC_DIST_X_EMAIL AS base_cnt_rfc_dist_x_email_gt1,
      BC.CNT_RFC_DIST_X_CEL AS base_cnt_rfc_dist_x_cel_gt1,
      M.MATCH_INV_CNT_RFC_DIST_X_EMAIL_GT1 AS match_inv_cnt_rfc_dist_x_email_gt1,
      M.MATCH_INV_CNT_RFC_DIST_X_CEL_GT1 AS match_inv_cnt_rfc_dist_x_cel_gt1,
      NULLIF(M.MATCH_INV_LOG, "") AS match_inv_log
    )) AS INVESTIGACION_METRICAS_JSON,
    
    -- Dominio Red BFS
    IFNULL(B.BFS_TOTAL_CTAS_REL, 0) AS BFS_TOTAL_CTAS_REL,
    IFNULL(B.BFS_TOTAL_POCKET_REL, 0) AS BFS_TOTAL_POCKET_REL,
    COALESCE(B.BFS_RESUMEN_RIESGO_RED, 'SIN_VINCULOS') AS BFS_RESUMEN_RIESGO_RED,
    PARSE_JSON(B.BFS_NETWORK_GRAPH_JSON) AS BFS_NETWORK_GRAPH_JSON,

    -- Dominio Transaccional Off-Us / B24
    PARSE_JSON(TXN.TXN_OFFUS_B24_TRJ) AS TXN_OFFUS_B24_TRJ,
    PARSE_JSON(TXN.TXN_OFFUS_B24_CUENTA) AS TXN_OFFUS_B24_CUENTA,

  FROM UNIV_INI AS U
  INNER JOIN BIO_TRJ_EVAL AS T
    ON T.ID_ROW = CONCAT(CAST(U.CTA_CVE AS STRING), '|', CAST(U.TRJ_NUM AS STRING))
  LEFT JOIN BIO_CTA AS C
    ON C.CTA_CVE = U.CTA_CVE
  LEFT JOIN PRTNCIA_ALL AS P
    ON U.TRJ_NUM = P.TRJ_NUM
  LEFT JOIN OTP_RIESGO_FLAG AS OTP
    ON OTP.TRJ_NUM = U.TRJ_NUM
  LEFT JOIN AGG_CAMBIOS_OWNER AS CHG
    ON CHG.TRJ_NUM = U.TRJ_NUM
  LEFT JOIN MATCH_INV_METRICS AS M
    ON M.BASE_CTA_CVE = U.CTA_CVE
  LEFT JOIN BFS_FINAL_METRICS AS B
    ON B.ROOT_CTA = U.CTA_CVE
  LEFT JOIN CLIE_FTES_ALL AS CF
    ON CF.CTA_CVE = U.CTA_CVE
  LEFT JOIN (
    SELECT EMAIL_CLEAN, CNT_RFC_DIST_X_EMAIL 
    FROM (
      SELECT NULLIF(UPPER(TRIM(CTE_EMA)), '') AS EMAIL_CLEAN, COUNT(DISTINCT IF(REGEXP_CONTAINS(TRIM(IFNULL(CTE_CVE_RFC, '')), r'^0+'), NULL, SUBSTR(TRIM(CTE_CVE_RFC), 1, 13))) AS CNT_RFC_DIST_X_EMAIL
      FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CLIE_FTES_VPL`
      GROUP BY EMAIL_CLEAN HAVING COUNT(DISTINCT IF(REGEXP_CONTAINS(TRIM(IFNULL(CTE_CVE_RFC, '')), r'^0+'), NULL, SUBSTR(TRIM(CTE_CVE_RFC), 1, 13))) > 1
    )
  ) AS BE ON NULLIF(UPPER(TRIM(CF.EMAIL)), '') = BE.EMAIL_CLEAN
  LEFT JOIN (
    SELECT CEL_CLEAN, CNT_RFC_DIST_X_CEL
    FROM (
      SELECT SAFE_CAST(SUBSTR(ZEROS_TO_NULL(CAST(CTE_CEL AS STRING)), -10) AS NUMERIC) AS CEL_CLEAN, COUNT(DISTINCT IF(REGEXP_CONTAINS(TRIM(IFNULL(CTE_CVE_RFC, '')), r'^0+'), NULL, SUBSTR(TRIM(CTE_CVE_RFC), 1, 13))) AS CNT_RFC_DIST_X_CEL
      FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CLIE_FTES_VPL`
      GROUP BY CEL_CLEAN HAVING COUNT(DISTINCT IF(REGEXP_CONTAINS(TRIM(IFNULL(CTE_CVE_RFC, '')), r'^0+'), NULL, SUBSTR(TRIM(CTE_CVE_RFC), 1, 13))) > 1
    )
  ) AS BC ON CF.CEL = BC.CEL_CLEAN
  LEFT JOIN USR_CAT AS UC
    ON UC.USR = U.USR_VPL_CREA
  LEFT JOIN AGG_TXN_OFFUS_B24 AS TXN
    ON TXN.CTA_CVE = U.CTA_CVE
   AND TXN.TRJ_NUM = U.TRJ_NUM
  WHERE U.FLG_EMBO = 1
)
SELECT
  TRJ_NUM,
  USR_VPL_CREA,
  ID_PERF_VPL,
  TDA,
  FCH_GENERACION,
  HRA_GENERACION,
  TRJ_EDO_CVE,
  BLQ_TRJ_CVE,
  RAZON_BLQ_TRJ_CVE,
  -- Biométricos
  MATCH_BIO_STT,
  TRJ_BIO_REALIZADO_LOG,
  CTA_ENR_EXISTE,
  CTA_ENR_LOG,
  -- Pertenencia en Entrega
  FLG_PRTNCIA_MATCH,
  PRTNCIA_LOG,
  -- OTP Risk
  FLG_RIESGO_OTP,
  RIESGO_OTP_TIPO,
  OTP_OK_30M,
  OTP_FAIL_90M,
  OTP_CHG_OWNER_60M,

-- 2. INFORMACIÓN DEMOGRÁFICA Y DE ESTADOS POR CLIENTE Y CUENTA
-- ============================================================
CREATE TEMP TABLE REL_CLIENTE_CUENTAS AS (
  SELECT DISTINCT
    CTE_CVE_UNICO,
    CTA_CVE
  FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CTA_TRJ`
  WHERE CTE_CVE_UNICO IN (SELECT DISTINCT CTE_CVE_UNICO FROM UNIV_INI)
);

CREATE TEMP TABLE CLIE_FTES_ALL AS (
  SELECT DISTINCT
    R.CTE_CVE_UNICO,
    A.CTA_CVE,
    NULLIF(TRIM(CONCAT(
      TRIM(COALESCE(CTE_NOM, "")), " ",
      TRIM(COALESCE(CTE_APE_PAT, "")), " ",
      TRIM(COALESCE(CTE_APE_MAT, ""))
    )), "") AS NOMBRE,
    NULLIF(TRIM(COALESCE(CTE_APE_PAT, "")), "") AS APE_PAT,
    IF(REGEXP_CONTAINS(TRIM(CTE_CVE_RFC), r"^0+"), NULL, NULLIF(SUBSTR(TRIM(CTE_CVE_RFC), 1, 13), "")) AS CTE_CVE_RFC,
    SAFE_CAST(SUBSTR(ZEROS_TO_NULL(CAST(CTE_TEL AS STRING)), -10) AS NUMERIC) AS TEL,
    SAFE_CAST(SUBSTR(ZEROS_TO_NULL(CAST(CTE_CEL AS STRING)), -10) AS NUMERIC) AS CEL,
    NULLIF(UPPER(TRIM(CTE_EMA)), "") AS EMAIL,
    NULLIF(TRIM(CONCAT(
      TRIM(COALESCE(CTE_DES_DIR_UNO, "")), ", ",
      TRIM(COALESCE(CTE_DES_DIR_DOS, "")), ", ",
      COALESCE(CAST(CDP_CVE AS STRING), ""), ", ",
      TRIM(COALESCE(CTE_DES_CIU, ""))
    )), ", , ,") AS DIRECCION,
    NULLIF(SAFE_CAST(CDP_CVE AS STRING), "") AS CDP_CVE,
    NULLIF(TRIM(SEX_CVE), "") AS SEXO,
    CTE_FCH_NAC AS FCH_NAC,
    CTE_FCH_ALT AS FCH_APERTURA,
    NULLIF(TRIM(CTE_EMPR), "") AS EMPLEO,
    SAFE_CAST(SUBSTR(ZEROS_TO_NULL(CAST(CTE_TEL_OFI AS STRING)), -10) AS NUMERIC) AS TEL_OFI,
    NULLIF(TRIM(CTE_CONYUGE), "") AS NOM_CONYUGE,
    NULLIF(TRIM(CTE_NOM_REFERENCIA1), "") AS NOM_REF1,
    SAFE_CAST(SUBSTR(ZEROS_TO_NULL(CAST(CTE_TEL_REFERENCIA1 AS STRING)), -10) AS NUMERIC) AS TEL_REF1,
    NULLIF(TRIM(CTE_NOM_REFERENCIA2), "") AS NOM_REF2,
    SAFE_CAST(SUBSTR(ZEROS_TO_NULL(CAST(CTE_TEL_REFERENCIA2 AS STRING)), -10) AS NUMERIC) AS TEL_REF2
  FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_CLIE_FTES_VPL` AS A
  INNER JOIN REL_CLIENTE_CUENTAS AS R ON A.CTA_CVE = R.CTA_CVE
);

CREATE TEMP TABLE SDO_CTA_ALL AS (
  SELECT
    R.CTE_CVE_UNICO,
    A.CTA_CVE,
    NULLIF(A.BR_SOLIC_CVE, 0) AS BR_SOLIC_CVE,
    A.CTA_FCH_SOL,
    NULLIF(TRIM(A.CTA_EDO_CVE), "") AS CTA_EDO_CVE,
    A.CTA_NIV_MOR,
    A.CTA_IMP_LIM_CRD,
    A.CTA_SDO_ACT,
    NULLIF(TRIM(A.CTA_HIST_PAGOS), "") AS CTA_HIST_PAGOS,
    SAFE_CAST(A.CTA_TDA_APE AS INT64) AS TDA_APE,
    NULLIF(TRIM(CONCAT(IFNULL(A.CCR_CVE_BLQ_UNO, ""), IFNULL(SAFE_CAST(A.RAZON_BLQ_UNO_CVE AS STRING), ""))), "") AS BLOQ1,
    NULLIF(TRIM(CONCAT(IFNULL(A.CCR_CVE_BLQ_DOS, ""), IFNULL(SAFE_CAST(A.RAZON_BLQ_DOS_CVE AS STRING), ""))), "") AS BLOQ2,
    A.CTA_IMP_DEV_LTD AS CTA_DEV,
    A.CTA_IMP_PAG_LTD AS CTA_PAG,
    A.CTA_IMP_MCMP_LTD AS CTA_IMP,
    NULLIF(SUBSTR(SAFE_CAST(A.BR_TIPO AS STRING), 1, 3), "") AS BR_TIPO_3,
    A.TIP_INF
  FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VFAC_SDO_CTA_MES` AS A
  INNER JOIN REL_CLIENTE_CUENTAS AS R ON A.CTA_CVE = R.CTA_CVE
  WHERE A.ANIO = CUR_ANIO
    AND A.MES = CUR_MES
);

CREATE TEMP TABLE SOLICITUDES_ALL AS (
  SELECT DISTINCT
    S.CTE_CVE_UNICO,
    S.CTA_CVE,
    S.BR_SOLIC_CVE,
    COALESCE(S.CTA_FCH_SOL, F.FCH_SOL) AS FCH_SOL,
    F.HRA_SOL,
    NULLIF(TRIM(F.BRAND), "") AS BRAND,
    NULLIF(TRIM(F.CL), "") AS CL,
    NULLIF(TRIM(F.STT_FICO), "") AS STT_FICO,
    NULLIF(TRIM(F.STT_SIMP_FICO), "") AS STT_SIMP_FICO,
    NULLIF(TRIM(F.BR_RFC), "") AS FICO_RFC,
    NULLIF(TRIM(A.BR_CURP), "") AS APIA_CURP,
    NULLIF(TRIM(A.BR_RFC), "") AS APIA_RFC,
    S.BR_TIPO_3,
    S.TIP_INF
  FROM SDO_CTA_ALL AS S
  LEFT JOIN `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_REP_SOL_FICO` AS F
    ON S.BR_SOLIC_CVE = NULLIF(SAFE_CAST(F.BR_SOLIC_CVE AS NUMERIC), 0)
  LEFT JOIN `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VFAC_APIA` AS A
    ON S.BR_SOLIC_CVE = A.BR_SOLIC_CVE
   AND S.BR_TIPO_3 = SUBSTR(SAFE_CAST(A.BR_TIPO AS STRING), 1, 3)
   AND SAFE_CAST(S.TIP_INF AS STRING) = SAFE_CAST(A.BR_ORG AS STRING)
  WHERE S.BR_SOLIC_CVE IS NOT NULL
);

CREATE TEMP TABLE PRTNCIA_ALL AS (
  SELECT 
    NULLIF(TRIM(A.CODIGO_ACCION), "") AS CODIGO_ACCION,
    A.NUMERO_CUENTA AS CTA_CVE,
    COALESCE(B.TRJ_NUM, A.NUMERO_TARJETA) AS TRJ_NUM,
    A.TIENDA_AUTENTICACION AS TDA_ATENCION,
    NULLIF(TRIM(A.ID), "") AS ID_ATENCION,
    A.FECHA,
    A.HORA,
    SAFE_CAST(A.BYPASS AS INT64) AS BYPASS_I,
    SAFE_CAST(A.AUTENTICADO AS INT64) AS AUTENTICADO_I,
    SAFE_CAST(A.AUTENTICACION AS INT64) AS AUTENTICACION_I,
    NULLIF(TRIM(UPPER(A.CORREO_ELECTRONICO)), "") AS EMAIL,
    CAST(SUBSTR(CAST(A.NUMERO_CELULAR AS STRING), -10) AS NUMERIC) AS CEL
  FROM `crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_PRTNCIA_DATOS` AS A
  INNER JOIN UNIV_INI AS B
    ON A.NUMERO_CUENTA = B.CTA_CVE 
   AND A.FECHA = B.FCH_GENERACION
  WHERE TRIM(A.CODIGO_ACCION) IN ("EMBO", "TPRO", "VALE", "REPO") 
  QUALIFY ROW_NUMBER() OVER (PARTITION BY A.FECHA, COALESCE(B.TRJ_NUM, A.NUMERO_TARJETA) ORDER BY A.FECHA DESC, A.HORA DESC) = 1 
);

